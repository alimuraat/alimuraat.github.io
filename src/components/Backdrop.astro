---
/**
 * The fixed background layers, in paint order:
 *   1. .bg-glow / .bg-glow-low  — red light bleeding in at the top and bottom
 *   2. #net                     — the canvas, one scene per page
 *   3. .bg-grid                 — 46px grid across the whole viewport
 *   4. .bg-scan                 — 3px CRT scanline
 *
 * Every layer is pointer-events:none and sits below the z-index:2 content, and
 * because the canvas is position:fixed the scene covers the viewport at any
 * scroll position — the motion never runs out halfway down a long page.
 *
 * Each scene is its own component so only the one a page uses is bundled into
 * that page; they share the harness in src/scripts/stage.ts.
 *
 *   recon      — pointer-driven scan sweep, probing hosts      (/)
 *   trace      — traceroute resolving hop by hop               (/experience)
 *   spread     — compromise propagating, then a patch wave     (/research)
 *   pipeline   — build jobs moving through stage gates         (/projects)
 *   cipher     — permutation network shuffling lanes           (/certifications)
 *   links      — connections opening between endpoints         (/travel)
 *   handshake  — key exchange across a channel                 (/contact)
 */
import Recon from './backdrops/Recon.astro';
import Trace from './backdrops/Trace.astro';
import Spread from './backdrops/Spread.astro';
import Pipeline from './backdrops/Pipeline.astro';
import Cipher from './backdrops/Cipher.astro';
import Links from './backdrops/Links.astro';
import Handshake from './backdrops/Handshake.astro';

interface Props {
  variant?: 'recon' | 'trace' | 'spread' | 'pipeline' | 'cipher' | 'links' | 'handshake';
}

const { variant = 'recon' } = Astro.props;
---

<div class="bg-glow" aria-hidden="true"></div>
<div class="bg-glow-low" aria-hidden="true"></div>
<canvas id="net" aria-hidden="true" data-variant={variant}></canvas>
<div class="bg-grid" aria-hidden="true"></div>
<div class="bg-scan" aria-hidden="true"></div>

{variant === 'recon' && <Recon />}
{variant === 'trace' && <Trace />}
{variant === 'spread' && <Spread />}
{variant === 'pipeline' && <Pipeline />}
{variant === 'cipher' && <Cipher />}
{variant === 'links' && <Links />}
{variant === 'handshake' && <Handshake />}
