---
/**
 * The fixed background layers, in paint order:
 *   1. .bg-glow / .bg-glow-low  — red light bleeding in at the top and bottom
 *   2. #net                     — the canvas, one scene per page
 *   3. .bg-grid                 — 46px grid across the whole viewport
 *   4. .bg-scan                 — 3px CRT scanline
 *
 * Every layer is pointer-events:none and sits below the z-index:2 content, and
 * because the canvas is position:fixed the scene covers the viewport at any
 * scroll position.
 *
 * Each page gets a different *medium*, not the same motion rearranged: a scan
 * field, a log, a hex dump, a tree, a matrix, a wireframe globe, a waveform.
 * Scenes are separate components so a page bundles only the one it uses; they
 * share the harness in src/scripts/stage.ts.
 *
 *   recon    — address space under a rotating scan     (/)
 *   authlog  — access log entries granting and denying (/experience)
 *   disclosure — advisory timelines crossing a now line   (/research)
 *   build      — isometric modules rising and settling    (/projects)
 *   assessment — a maturity radar re-measuring itself     (/certifications)
 *   globe    — wireframe globe turning                 (/travel)
 *   entropy  — signal bands converting to ciphertext   (/contact)
 */
import Recon from './backdrops/Recon.astro';
import Authlog from './backdrops/Authlog.astro';
import Disclosure from './backdrops/Disclosure.astro';
import Build from './backdrops/Build.astro';
import Assessment from './backdrops/Assessment.astro';
import Globe from './backdrops/Globe.astro';
import Entropy from './backdrops/Entropy.astro';

interface Props {
  variant?: 'recon' | 'authlog' | 'disclosure' | 'build' | 'assessment' | 'globe' | 'entropy';
}

const { variant = 'recon' } = Astro.props;
---

<div class="bg-glow" aria-hidden="true"></div>
<div class="bg-glow-low" aria-hidden="true"></div>
<canvas id="net" aria-hidden="true" data-variant={variant}></canvas>
<div class="bg-grid" aria-hidden="true"></div>
<div class="bg-scan" aria-hidden="true"></div>

{variant === 'recon' && <Recon />}
{variant === 'authlog' && <Authlog />}
{variant === 'disclosure' && <Disclosure />}
{variant === 'build' && <Build />}
{variant === 'assessment' && <Assessment />}
{variant === 'globe' && <Globe />}
{variant === 'entropy' && <Entropy />}
