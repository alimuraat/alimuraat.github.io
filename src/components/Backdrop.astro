---
/**
 * The fixed background layers, in paint order:
 *   1. .bg-glow / .bg-glow-low  — red light bleeding in at the top and bottom
 *   2. #net                     — the canvas, one visualisation per page
 *   3. .bg-scrim                — soft darkening down the content column
 *   4. .bg-grid                 — 46px grid across the whole viewport
 *   5. .bg-scan                 — 3px CRT scanline
 *
 * The backdrops are drawn from the tools of the trade rather than from the film
 * version of them — no falling glyphs, no green terminal, no padlocks. On a
 * wide screen they sit to the right of the column the copy lives in, so nothing
 * is ever read through a moving picture.
 *
 *   binvis     — an address space on a Hilbert curve, read by the pointer  (/)
 *   flame      — a flame graph                                (/experience)
 *   fuzz       — a coverage bitmap filling in, with crashes   (/research)
 *   treemap    — what a codebase is made of                   (/projects)
 *   avalanche  — one input bit flipped, the digest comes apart (/certifications)
 *   azimuth    — ranges measured from Istanbul                (/travel)
 *   randomart  — the drunken bishop, as on a key fingerprint  (/contact)
 */
import Binvis from './backdrops/Binvis.astro';
import Panel from './backdrops/Panel.astro';

interface Props {
  variant?: 'binvis' | 'flame' | 'fuzz' | 'treemap' | 'avalanche' | 'azimuth' | 'randomart';
}

const { variant = 'binvis' } = Astro.props;
---

<div class="bg-glow" aria-hidden="true"></div>
<div class="bg-glow-low" aria-hidden="true"></div>
<canvas id="net" aria-hidden="true" data-variant={variant}></canvas>
<div class="bg-scrim" aria-hidden="true"></div>
<div class="bg-grid" aria-hidden="true"></div>
<div class="bg-scan" aria-hidden="true"></div>

{variant === 'binvis' && <Binvis />}
{variant !== 'binvis' && <Panel />}
