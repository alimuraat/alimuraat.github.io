---
/**
 * The fixed background layers, in paint order:
 *   1. .bg-glow / .bg-glow-low  — red light bleeding in at the top and bottom
 *   2. #net                     — the canvas: the measuring frame and one small
 *                                 instrument, per page
 *   3. .bg-scrim                — soft darkening down the content column
 *   4. .bg-grid                 — 46px grid across the whole viewport
 *   5. .bg-scan                 — 3px CRT scanline
 *
 * The backdrop is instrumentation, not a picture: nothing fills the viewport.
 * There is a measuring frame around the edges and one small instrument in the
 * lower right, and which instrument depends on the page.
 *
 *   scan       — a sweep over a block of hosts        (/)
 *   track      — five notches, newest at the right    (/experience)
 *   severity   — a dial settling on a score           (/research)
 *   pipeline   — five gates, one job walking them     (/projects)
 *   seal       — a stamp with fine graduations        (/certifications)
 *   globe      — a small wireframe globe, turning     (/travel)
 *   handshake  — a pulse crossing, sealing on arrival (/contact)
 */
import Console from './backdrops/Console.astro';

interface Props {
  variant?: 'scan' | 'track' | 'severity' | 'pipeline' | 'seal' | 'globe' | 'handshake';
}

const { variant = 'scan' } = Astro.props;
---

<div class="bg-glow" aria-hidden="true"></div>
<div class="bg-glow-low" aria-hidden="true"></div>
<canvas id="net" aria-hidden="true" data-variant={variant}></canvas>
<div class="bg-scrim" aria-hidden="true"></div>
<div class="bg-grid" aria-hidden="true"></div>
<div class="bg-scan" aria-hidden="true"></div>

<Console />
