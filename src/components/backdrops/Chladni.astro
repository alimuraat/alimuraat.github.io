---
/**
 * Contact — a Chladni figure.
 *
 * A plate driven at one mode has places that do not move at all:
 *
 *   f(x,y) = sin(nπx)·sin(mπy) − sin(mπx)·sin(nπy)
 *
 * The figure is where f = 0. It is drawn from the field itself — sampled on a
 * lattice, with the two sine tables rebuilt only when the mode changes, so a
 * full-screen evaluation costs two multiplies a cell — and the particles on
 * top wander with a step scaled by how hard the plate is shaking under them,
 * which lands them on the same lines from the other direction.
 *
 * Mode numbers stay whole. Between two whole numbers the nodal lines do not
 * close and nothing resolves, so instead of easing between modes the plate is
 * struck: the pattern is thrown apart and settles into the next one.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  stage(
    (k) => {
      const { c, W, H, anim, RED } = k;

      const CELL = 5;
      const gw = Math.ceil(W / CELL) + 1;
      const gh = Math.ceil(H / CELL) + 1;
      const PI = Math.PI;

      /* sin(mode·π·u) for every column and row, per mode. */
      const SX: Record<number, Float32Array> = {};
      const SY: Record<number, Float32Array> = {};
      const table = (mode: number) => {
        if (SX[mode]) return;
        const cx = new Float32Array(gw);
        const cy = new Float32Array(gh);
        for (let i = 0; i < gw; i++) cx[i] = Math.sin((mode * PI * (i * CELL)) / W);
        for (let j = 0; j < gh; j++) cy[j] = Math.sin((mode * PI * (j * CELL)) / H);
        SX[mode] = cx;
        SY[mode] = cy;
      };

      let n = 3;
      let m = 5;
      table(n);
      table(m);

      const N = Math.max(900, Math.min(3000, Math.round((W * H) / 700)));
      const P = new Float32Array(N * 2);
      for (let i = 0; i < N; i++) {
        P[i * 2] = Math.random() * W;
        P[i * 2 + 1] = Math.random() * H;
      }

      let shake = 0;
      let f = 0;

      const at = (x: number, y: number) => {
        const u = x / W;
        const v = y / H;
        return (
          Math.sin(n * PI * u) * Math.sin(m * PI * v) - Math.sin(m * PI * u) * Math.sin(n * PI * v)
        );
      };

      return () => {
        f++;
        if (anim && f % 620 === 0) {
          let a = 1 + ((Math.random() * 6) | 0);
          let b = 1 + ((Math.random() * 6) | 0);
          if (a === b) b = a === 6 ? 1 : b + 1;
          n = a;
          m = b;
          table(n);
          table(m);
          shake = 100;
        }
        if (shake > 0 && anim) shake--;

        const settleIn = shake > 0 ? 1 - shake / 100 : 1;
        const xn = SX[n];
        const xm = SX[m];
        const yn = SY[n];
        const ym = SY[m];

        /* The figure: everywhere the field is close to zero. */
        for (let j = 0; j < gh; j++) {
          const a = ym[j];
          const b = yn[j];
          for (let i = 0; i < gw; i++) {
            const v = Math.abs(xn[i] * a - xm[i] * b);
            if (v > 0.16) continue;
            const t = 1 - v / 0.16;
            c.fillStyle = `rgba(${RED},${(t * t * 0.14 * settleIn).toFixed(3)})`;
            c.fillRect(i * CELL, j * CELL, CELL, CELL);
          }
        }

        /* The sand. */
        const kick = shake > 0 ? 1 + (shake / 100) * 6 : 1;
        for (let i = 0; i < N; i++) {
          const o = i * 2;
          let x = P[o];
          let y = P[o + 1];

          if (anim) {
            const amp = Math.abs(at(x, y));
            const step = (0.1 + amp * amp * 9) * kick;
            x += (Math.random() - 0.5) * step * 2;
            y += (Math.random() - 0.5) * step * 2;
            if (x < 0) x = -x;
            else if (x > W) x = W - (x - W);
            if (y < 0) y = -y;
            else if (y > H) y = H - (y - H);
            P[o] = x;
            P[o + 1] = y;
          }

          const settled = 1 - Math.min(1, Math.abs(at(x, y)) * 7);
          c.fillStyle = `rgba(255,190,196,${(0.06 + settled * settled * 0.45).toFixed(3)})`;
          c.fillRect(x - 0.7, y - 0.7, 1.6, 1.6);
        }
      };
    },
    { trail: 0.1, additive: true }
  );
</script>
