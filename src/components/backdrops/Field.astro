---
/**
 * One visual language for the whole site, with a different behaviour per page.
 *
 * The language is the one the site started with and the one this kind of site
 * tends to get right: a sparse constellation of nodes, hairline links between
 * the near ones, and small lights travelling along them. The field is weighted
 * toward the middle of the viewport so the movement reads as one thing in the
 * centre rather than as noise spread to the corners, and the edges stay clean.
 *
 * What differs per page is what the constellation *does*:
 *
 *   mesh    — drifts, with packets crossing random links   (/)
 *   chain   — a walker takes a path through it, node by node (/experience)
 *   flare   — one node ignites and it spreads, then heals  (/research)
 *   cluster — nodes gather into modules, then regroup       (/projects)
 *   align   — nodes settle onto concentric rings and hold   (/certifications)
 *   routes  — long arcs open between distant nodes          (/travel)
 *   relay   — two groups pass packets across the gap        (/contact)
 */
---

<script>
  import { stage } from '../../scripts/stage';

  type Kind = 'mesh' | 'chain' | 'flare' | 'cluster' | 'align' | 'routes' | 'relay';

  stage(
    (k) => {
      const { c, W, H, anim, rand, RED, glow } = k;

      const kind = ((document.getElementById('net') as HTMLCanvasElement).dataset.variant ??
        'mesh') as Kind;

      const LINK = Math.min(200, Math.max(140, Math.min(W, H) * 0.2));
      /* The density the first version had — one node per ~16k px. Crowding it
         toward the middle without raising the count is what made it look
         empty. */
      const N = Math.max(34, Math.min(96, Math.round((W * H) / 16000)));
      const cx = W / 2;
      const cy = H * 0.48;
      const spanX = W * 0.46;
      const spanY = H * 0.46;

      const halo = glow(15, '255,90,105', 0.7);
      const core = glow(4, '255,205,210', 0.95);

      type Node = {
        x: number;
        y: number;
        vx: number;
        vy: number;
        tx: number;
        ty: number;
        lit: number;
        group: number;
      };

      /* Center-weighted placement: u^0.62 crowds the middle without leaving a
         hole in it the way a plain radius would. */
      const place = (): [number, number] => {
        const a = Math.random() * 6.2832;
        const u = Math.pow(Math.random(), 0.62);
        return [cx + Math.cos(a) * u * spanX, cy + Math.sin(a) * u * spanY];
      };

      const nodes: Node[] = Array.from({ length: N }, () => {
        const [x, y] = place();
        return { x, y, vx: rand(-0.09, 0.09), vy: rand(-0.09, 0.09), tx: x, ty: y, lit: -1e9, group: 0 };
      });

      type Packet = { a: number; b: number; t: number; sp: number; hot: number };
      const packets: Packet[] = [];
      type Arc = { a: number; b: number; t: number; hold: number };
      const arcs: Arc[] = [];

      let f = 0;

      /* --- per-page state ------------------------------------------------- */
      let path: number[] = [];
      let step = 0;
      let walk = 0;
      const lit: number[] = [];

      const nearest = (i: number, avoid: number[] = []) => {
        let best = -1;
        let bd = Infinity;
        for (let j = 0; j < N; j++) {
          if (j === i || avoid.includes(j)) continue;
          const d = Math.hypot(nodes[j].x - nodes[i].x, nodes[j].y - nodes[i].y);
          if (d < bd) {
            bd = d;
            best = j;
          }
        }
        return best;
      };

      const newPath = () => {
        path = [(Math.random() * N) | 0];
        for (let s = 0; s < 7; s++) {
          const n = nearest(path[path.length - 1], path);
          if (n < 0) break;
          path.push(n);
        }
        step = 0;
        walk = 0;
      };

      const groups = 3;
      const centres = Array.from({ length: groups }, () => place());
      const regroup = () => {
        for (let g = 0; g < groups; g++) centres[g] = place();
        for (const n of nodes) n.group = (Math.random() * groups) | 0;
      };

      const ringTargets = () => {
        nodes.forEach((n, i) => {
          const ring = 1 + (i % 3);
          const a = (i / N) * 6.2832 * 2.6;
          const r = (Math.min(spanX, spanY) * ring) / 3.4;
          n.tx = cx + Math.cos(a) * r;
          n.ty = cy + Math.sin(a) * r;
        });
      };

      if (kind === 'chain') newPath();
      if (kind === 'cluster') regroup();
      if (kind === 'align') ringTargets();
      if (kind === 'relay') {
        nodes.forEach((n, i) => {
          n.group = i % 2;
          const side = n.group ? 1 : -1;
          n.tx = cx + side * spanX * rand(0.35, 0.95);
          n.ty = cy + rand(-spanY * 0.8, spanY * 0.8);
          n.x = n.tx;
          n.y = n.ty;
        });
      }

      const send = (a: number, b: number, hot = 0) => {
        if (packets.length > 7) return;
        packets.push({ a, b, t: 0, sp: rand(0.008, 0.016), hot });
      };

      return () => {
        f++;

        /* --- motion ----------------------------------------------------- */
        for (const n of nodes) {
          if (!anim) break;
          if (kind === 'mesh' || kind === 'chain' || kind === 'flare' || kind === 'routes') {
            n.x += n.vx;
            n.y += n.vy;
            const dx = (n.x - cx) / spanX;
            const dy = (n.y - cy) / spanY;
            if (dx * dx + dy * dy > 1) {
              n.vx -= dx * 0.006;
              n.vy -= dy * 0.006;
            }
          } else if (kind === 'cluster') {
            const [gx, gy] = centres[n.group];
            n.x += (gx - n.x) * 0.006 + n.vx * 0.3;
            n.y += (gy - n.y) * 0.006 + n.vy * 0.3;
          } else {
            n.x += (n.tx - n.x) * 0.022;
            n.y += (n.ty - n.y) * 0.022;
          }
        }

        if (anim) {
          if (kind === 'cluster' && f % 900 === 0) regroup();
          if (kind === 'align' && f % 1100 === 0) {
            if (Math.random() < 0.5) ringTargets();
            else
              nodes.forEach((n) => {
                const [x, y] = place();
                n.tx = x;
                n.ty = y;
              });
          }
        }

        /* --- links ------------------------------------------------------- */
        c.lineWidth = 1;
        for (let i = 0; i < N; i++) {
          const p = nodes[i];
          for (let j = i + 1; j < N; j++) {
            const q = nodes[j];
            const d = Math.hypot(q.x - p.x, q.y - p.y);
            if (d >= LINK) continue;
            const near = 1 - d / LINK;
            const heat =
              Math.max(0, 1 - (f - p.lit) / 90) * 0.5 + Math.max(0, 1 - (f - q.lit) / 90) * 0.5;
            c.strokeStyle = `rgba(${RED},${(near * (0.2 + heat * 0.45)).toFixed(3)})`;
            c.beginPath();
            c.moveTo(p.x, p.y);
            c.lineTo(q.x, q.y);
            c.stroke();
          }
        }

        /* --- per-page behaviour ----------------------------------------- */
        if (kind === 'mesh') {
          if (anim && Math.random() < 0.045) {
            const a = (Math.random() * N) | 0;
            const b = nearest(a);
            if (b >= 0) send(a, b);
          }
        } else if (kind === 'chain') {
          if (anim) {
            walk += 0.012;
            if (walk >= 1) {
              walk = 0;
              nodes[path[step]].lit = f;
              step++;
              if (step >= path.length - 1) newPath();
            }
          }
          /* The stretch already walked stays drawn, brighter at the head. */
          for (let s = 0; s < path.length - 1; s++) {
            const a = nodes[path[s]];
            const b = nodes[path[s + 1]];
            const done = s < step;
            const u = s === step ? walk : done ? 1 : 0;
            if (u <= 0) continue;
            c.strokeStyle = `rgba(${RED},${(done ? 0.3 : 0.5).toFixed(3)})`;
            c.beginPath();
            c.moveTo(a.x, a.y);
            c.lineTo(a.x + (b.x - a.x) * u, a.y + (b.y - a.y) * u);
            c.stroke();
          }
          const head = nodes[path[Math.min(step, path.length - 1)]];
          const nxt = nodes[path[Math.min(step + 1, path.length - 1)]];
          const hx = head.x + (nxt.x - head.x) * walk;
          const hy = head.y + (nxt.y - head.y) * walk;
          c.drawImage(halo, hx - 15, hy - 15, 30, 30);
          c.drawImage(core, hx - 4, hy - 4, 8, 8);
        } else if (kind === 'flare') {
          if (anim && (f % 260 === 0 || lit.length === 0)) {
            lit.length = 0;
            lit.push((Math.random() * N) | 0);
            nodes[lit[0]].lit = f;
          }
          if (anim && f % 26 === 0 && lit.length) {
            const from = lit[lit.length - 1];
            const to = nearest(from, lit);
            if (to >= 0) {
              lit.push(to);
              nodes[to].lit = f;
              send(from, to, 1);
            }
          }
        } else if (kind === 'cluster') {
          if (anim && Math.random() < 0.05) {
            const a = (Math.random() * N) | 0;
            const b = nearest(a);
            if (b >= 0) send(a, b);
          }
        } else if (kind === 'align') {
          /* Rings, drawn faintly so the arrangement reads as deliberate. */
          c.strokeStyle = `rgba(${RED},.05)`;
          for (let r = 1; r <= 3; r++) {
            c.beginPath();
            c.ellipse(cx, cy, (spanX * r) / 3.4, (spanY * r) / 3.4, 0, 0, 6.2832);
            c.stroke();
          }
        } else if (kind === 'routes') {
          if (anim && arcs.length < 3 && Math.random() < 0.012) {
            const a = (Math.random() * N) | 0;
            let b = (Math.random() * N) | 0;
            if (Math.hypot(nodes[a].x - nodes[b].x, nodes[a].y - nodes[b].y) < LINK * 1.6)
              b = (b + (N >> 1)) % N;
            arcs.push({ a, b, t: 0, hold: 0 });
          }
          for (let i = arcs.length - 1; i >= 0; i--) {
            const arc = arcs[i];
            if (anim) {
              if (arc.t < 1) arc.t = Math.min(1, arc.t + 0.008);
              else arc.hold++;
            }
            if (arc.hold > 220) {
              arcs.splice(i, 1);
              continue;
            }
            const a = nodes[arc.a];
            const b = nodes[arc.b];
            const mx = (a.x + b.x) / 2;
            const my = (a.y + b.y) / 2 - Math.hypot(b.x - a.x, b.y - a.y) * 0.22;
            const fade = arc.hold > 120 ? 1 - (arc.hold - 120) / 100 : 1;
            c.strokeStyle = `rgba(${RED},${(0.26 * fade).toFixed(3)})`;
            c.beginPath();
            c.moveTo(a.x, a.y);
            for (let s = 1; s <= 24 * arc.t; s++) {
              const u = s / 24;
              const v = 1 - u;
              c.lineTo(v * v * a.x + 2 * v * u * mx + u * u * b.x, v * v * a.y + 2 * v * u * my + u * u * b.y);
            }
            c.stroke();
            if (arc.t < 1) {
              const u = arc.t;
              const v = 1 - u;
              const px = v * v * a.x + 2 * v * u * mx + u * u * b.x;
              const py = v * v * a.y + 2 * v * u * my + u * u * b.y;
              c.drawImage(halo, px - 13, py - 13, 26, 26);
              c.drawImage(core, px - 3.5, py - 3.5, 7, 7);
            }
          }
        } else {
          /* relay */
          if (anim && Math.random() < 0.035) {
            const from = nodes.findIndex((n, i) => n.group === (f & 1) && i >= 0);
            const a = from >= 0 ? from : 0;
            let b = -1;
            let bd = Infinity;
            for (let j = 0; j < N; j++) {
              if (nodes[j].group === nodes[a].group) continue;
              const d = Math.hypot(nodes[j].x - nodes[a].x, nodes[j].y - nodes[a].y);
              if (d < bd) {
                bd = d;
                b = j;
              }
            }
            if (b >= 0) send(a, b, 1);
          }
        }

        /* --- packets ----------------------------------------------------- */
        for (let i = packets.length - 1; i >= 0; i--) {
          const p = packets[i];
          const a = nodes[p.a];
          const b = nodes[p.b];
          if (anim) p.t += p.sp;
          if (p.t >= 1) {
            nodes[p.b].lit = f;
            packets.splice(i, 1);
            continue;
          }
          const x = a.x + (b.x - a.x) * p.t;
          const y = a.y + (b.y - a.y) * p.t;
          const r = p.hot ? 19 : 15;
          c.drawImage(halo, x - r, y - r, r * 2, r * 2);
          c.drawImage(core, x - 4, y - 4, 8, 8);
        }

        /* --- nodes ------------------------------------------------------- */
        for (const n of nodes) {
          const heat = Math.max(0, 1 - (f - n.lit) / 140);
          c.fillStyle = `rgba(${RED},${(0.42 + heat * 0.5).toFixed(3)})`;
          const r = 1.3 + heat * 1.6;
          c.beginPath();
          c.arc(n.x, n.y, r, 0, 6.2832);
          c.fill();
          if (heat > 0.5) {
            c.strokeStyle = `rgba(${RED},${((heat - 0.5) * 0.6).toFixed(3)})`;
            c.beginPath();
            c.arc(n.x, n.y, 4 + (1 - heat) * 18, 0, 6.2832);
            c.stroke();
          }
        }
      };
    },
    { additive: false }
  );
</script>
