---
/**
 * Travel — aurora.
 *
 * Ribbons of light drift across the viewport, each one a curve with a vertical
 * gradient hung off it. They cross and add up where they overlap, which is
 * where the colour comes from — nothing is painted bright on its own.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  stage(
    (k) => {
      const { c, W, H, anim, rand, glow } = k;

      const TONES = ['255,51,68', '255,90,105', '255,140,120', '58,160,255'];
      const core = glow(22, '255,190,196', 0.5);

      const bands = Array.from({ length: 6 }, (_, i) => ({
        y: H * (0.16 + i * 0.14) + rand(-40, 40),
        amp: rand(H * 0.05, H * 0.16),
        freq: rand(0.9, 2.1),
        phase: rand(0, 6.2832),
        drift: rand(0.0016, 0.0042) * (Math.random() < 0.5 ? -1 : 1),
        thick: rand(H * 0.05, H * 0.13),
        tone: TONES[i % TONES.length],
        alpha: rand(0.07, 0.13),
      }));

      const STEP = 26;
      const pts = Math.ceil(W / STEP) + 2;

      return () => {
        for (const b of bands) {
          if (anim) b.phase += b.drift;

          const yAt = (x: number) =>
            b.y +
            Math.sin((x / W) * 6.2832 * b.freq + b.phase) * b.amp +
            Math.sin((x / W) * 6.2832 * b.freq * 2.3 + b.phase * 1.7) * b.amp * 0.35;

          /* The sheet: one path, one vertical gradient. */
          const g = c.createLinearGradient(0, b.y - b.amp - b.thick, 0, b.y + b.amp + b.thick);
          g.addColorStop(0, `rgba(${b.tone},0)`);
          g.addColorStop(0.5, `rgba(${b.tone},${b.alpha})`);
          g.addColorStop(1, `rgba(${b.tone},0)`);
          c.fillStyle = g;

          c.beginPath();
          for (let i = 0; i < pts; i++) {
            const x = i * STEP;
            const y = yAt(x) - b.thick;
            if (i === 0) c.moveTo(x, y);
            else c.lineTo(x, y);
          }
          for (let i = pts - 1; i >= 0; i--) {
            const x = i * STEP;
            c.lineTo(x, yAt(x) + b.thick);
          }
          c.closePath();
          c.fill();

          /* A brighter filament along the centre line. */
          for (let i = 0; i < pts; i += 2) {
            const x = i * STEP;
            const y = yAt(x);
            const r = 12 + Math.sin((x / W) * 9 + b.phase * 3) * 5;
            c.globalAlpha = 0.1;
            c.drawImage(core, x - r, y - r, r * 2, r * 2);
          }
          c.globalAlpha = 1;
        }
      };
    },
    { additive: true }
  );
</script>
