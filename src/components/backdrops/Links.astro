---
/**
 * Travel — connections opening between endpoints.
 *
 * An arc draws itself from one endpoint to another, lands with a ring, holds,
 * then fades. Several run at once across the whole viewport, so the page keeps
 * moving well below the map.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  stage((k) => {
    const { c, W, H, anim, rand, RED } = k;

    const SITES = Math.max(9, Math.min(20, Math.round((W * H) / 90000)));
    const sites = Array.from({ length: SITES }, () => ({
      x: rand(W * 0.04, W * 0.96),
      y: rand(H * 0.06, H * 0.94),
    }));

    type Conn = { a: number; b: number; cx: number; cy: number; u: number; sp: number; hold: number };
    const conns: Conn[] = [];

    const open = () => {
      if (sites.length < 2) return;
      const a = (Math.random() * sites.length) | 0;
      let b = (Math.random() * sites.length) | 0;
      if (a === b) b = (b + 1) % sites.length;
      const p = sites[a];
      const q = sites[b];
      const mx = (p.x + q.x) / 2;
      const my = (p.y + q.y) / 2;
      /* Bow the arc perpendicular to the chord, always upward-ish. */
      const dx = q.x - p.x;
      const dy = q.y - p.y;
      const len = Math.hypot(dx, dy) || 1;
      const bow = Math.min(190, len * 0.28);
      conns.push({
        a,
        b,
        cx: mx - (dy / len) * bow * Math.sign(dy || 1),
        cy: my + (dx / len) * bow * Math.sign(dy || 1) - bow * 0.35,
        u: 0,
        sp: rand(0.005, 0.012),
        hold: 0,
      });
    };
    for (let i = 0; i < 3; i++) {
      open();
      conns[conns.length - 1].u = Math.random();
    }

    const at = (n: Conn, u: number) => {
      const p = sites[n.a];
      const q = sites[n.b];
      const v = 1 - u;
      return {
        x: v * v * p.x + 2 * v * u * n.cx + u * u * q.x,
        y: v * v * p.y + 2 * v * u * n.cy + u * u * q.y,
      };
    };

    let f = 0;

    return () => {
      f++;
      c.lineWidth = 1;

      for (const s of sites) {
        c.strokeStyle = `rgba(${RED},.28)`;
        c.beginPath();
        c.moveTo(s.x - 3, s.y);
        c.lineTo(s.x + 3, s.y);
        c.moveTo(s.x, s.y - 3);
        c.lineTo(s.x, s.y + 3);
        c.stroke();
      }

      for (let i = conns.length - 1; i >= 0; i--) {
        const n = conns[i];
        if (anim) {
          if (n.u < 1) n.u = Math.min(1, n.u + n.sp);
          else n.hold++;
        }
        if (n.hold > 260) {
          conns.splice(i, 1);
          continue;
        }

        const fade = n.hold > 140 ? 1 - (n.hold - 140) / 120 : 1;

        c.strokeStyle = `rgba(${RED},${(0.17 * fade).toFixed(3)})`;
        c.beginPath();
        const steps = 30;
        for (let s = 0; s <= steps * n.u; s++) {
          const p = at(n, (s / steps) * 1);
          if (s === 0) c.moveTo(p.x, p.y);
          else c.lineTo(p.x, p.y);
        }
        c.stroke();

        if (n.u < 1) {
          const head = at(n, n.u);
          const g = c.createRadialGradient(head.x, head.y, 0, head.x, head.y, 15);
          g.addColorStop(0, 'rgba(255,90,105,.55)');
          g.addColorStop(1, `rgba(${RED},0)`);
          c.fillStyle = g;
          c.beginPath();
          c.arc(head.x, head.y, 15, 0, 6.2832);
          c.fill();
          c.fillStyle = 'rgba(255,205,210,.9)';
          c.beginPath();
          c.arc(head.x, head.y, 1.8, 0, 6.2832);
          c.fill();
        } else if (n.hold < 90) {
          /* Landed: one ring at the far end. */
          const q = sites[n.b];
          const u = n.hold / 90;
          c.strokeStyle = `rgba(${RED},${((1 - u) * 0.45).toFixed(3)})`;
          c.beginPath();
          c.arc(q.x, q.y, 3 + u * 26, 0, 6.2832);
          c.stroke();
        }
      }

      if (anim && conns.length < 6 && Math.random() < 0.014) open();
    };
  });
</script>
