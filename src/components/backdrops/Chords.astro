---
/**
 * A sphere woven out of chords.
 *
 * Points are laid on the sphere by the Fibonacci lattice — the golden angle
 * spacing that gives an even cover without a pole problem — and then hundreds
 * of straight chords are strung through the inside between them. Nothing is
 * drawn on the surface; the shape is what the chords add up to, and because
 * they pass through the middle the centre carries the light. Chords fire in
 * turn, so the weave keeps moving without the ball ever spinning fast.
 */
---

<script>
  import { stage } from '../../scripts/stage';
  import { projector, spin, type Cam } from '../../scripts/space';

  stage(
    (k) => {
      const { c, W, H, anim, rand, RED } = k;

      const project = projector(W, H, W > 900 ? 0.66 : 0.5, 0.5);
      const cam: Cam = { x: 0, y: 0, z: -4.2, yaw: 0, pitch: 0, fov: Math.min(W, H) * 1.25 };

      const N = 260;
      const pts: [number, number, number][] = [];
      const GOLD = Math.PI * (3 - Math.sqrt(5));
      for (let i = 0; i < N; i++) {
        const y = 1 - (i / (N - 1)) * 2;
        const r = Math.sqrt(Math.max(0, 1 - y * y));
        const th = GOLD * i;
        pts.push([Math.cos(th) * r, y, Math.sin(th) * r]);
      }

      /* Chords between points that are neither neighbours nor antipodes — that
         band is what makes the weave look woven. */
      const links: [number, number, number][] = [];
      for (let i = 0; i < N; i++) {
        for (let n = 0; n < 6; n++) {
          const j = (Math.random() * N) | 0;
          if (j === i) continue;
          const d =
            pts[i][0] * pts[j][0] + pts[i][1] * pts[j][1] + pts[i][2] * pts[j][2];
          if (d > 0.35 || d < -0.75) continue;
          links.push([i, j, rand(0, 1)]);
        }
      }

      let ay = 0;
      let ax = 0.32;
      let t = 0;

      return () => {
        t += 0.006;
        if (anim) {
          ay += 0.0024;
          ax = 0.3 + Math.sin(t * 0.5) * 0.22;
        }

        const p = project(cam);
        const sx: number[] = [];
        const sy: number[] = [];
        const sz: number[] = [];
        for (let i = 0; i < N; i++) {
          const [x, y, z] = spin(pts[i][0], pts[i][1], pts[i][2], ay, ax);
          const q = p(x, y, z);
          if (!q) {
            sz[i] = -99;
            continue;
          }
          sx[i] = q.x;
          sy[i] = q.y;
          sz[i] = z;
        }

        c.lineWidth = 1;
        for (const [i, j, phase] of links) {
          if (sz[i] === -99 || sz[j] === -99) continue;
          const depth = (sz[i] + sz[j]) * 0.5;
          const near = (depth + 1) * 0.5;
          /* A slow travelling wave decides which chords are lit. */
          const fire = Math.max(0, Math.sin(t * 2 + phase * 6.2832));
          const a = 0.035 + near * 0.1 + fire * fire * 0.3;
          c.strokeStyle = `rgba(${RED},${a.toFixed(3)})`;
          c.beginPath();
          c.moveTo(sx[i], sy[i]);
          c.lineTo(sx[j], sy[j]);
          c.stroke();
        }

        for (let i = 0; i < N; i++) {
          if (sz[i] === -99) continue;
          const near = (sz[i] + 1) * 0.5;
          if (near < 0.35) continue;
          c.fillStyle = `rgba(255,190,196,${(near * 0.5).toFixed(3)})`;
          c.fillRect(sx[i] - 1, sy[i] - 1, 2, 2);
        }
      };
    },
    { additive: true }
  );
</script>
