---
/**
 * Projects — a lit skyline in isometric.
 *
 * Blocks stand on an isometric ground plane and a band of light sweeps across
 * it diagonally; whatever it touches lights its roof and throws a beam. Drawn
 * back to front so the overlaps read correctly.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  stage(
    (k) => {
      const { c, W, H, anim, rand, RED, glow } = k;

      const S = 48;
      const KX = S * 0.866;
      const KY = S * 0.5;
      const KZ = S * 0.62;

      const N = Math.ceil(Math.max(W / KX, H / KY) / 2) + 3;
      const ox = W * 0.5;
      const oy = H * 0.46;

      const iso = (x: number, y: number, z: number) => ({
        x: ox + (x - y) * KX,
        y: oy + (x + y) * KY - z * KZ,
      });

      const roof = glow(34, '255,90,105', 0.42);
      const spark = glow(9, '255,220,224', 0.8);

      const mods = [] as { x: number; y: number; h: number; to: number; wait: number; d: number }[];
      for (let x = -N; x <= N; x++) {
        for (let y = -N; y <= N; y++) {
          const p = iso(x, y, 0);
          if (p.x < -S * 2 || p.x > W + S * 2 || p.y < -S * 4 || p.y > H + S * 2) continue;
          if (Math.random() > 0.19) continue;
          const h = rand(0.4, 3);
          mods.push({ x, y, h, to: h, wait: rand(0, 500), d: p.x + p.y * 0.6 });
        }
      }
      mods.sort((a, b) => a.x + a.y - (b.x + b.y));

      const span = W + H * 0.6 + 400;
      let wave = -200;

      return () => {
        if (anim) {
          wave += 3.4;
          if (wave > span) wave = -200;
        }

        /* Ground. */
        c.lineWidth = 1;
        c.strokeStyle = `rgba(${RED},.06)`;
        c.beginPath();
        for (let i = -N; i <= N; i++) {
          const a = iso(i, -N, 0);
          const b = iso(i, N, 0);
          c.moveTo(a.x, a.y);
          c.lineTo(b.x, b.y);
          const d = iso(-N, i, 0);
          const e = iso(N, i, 0);
          c.moveTo(d.x, d.y);
          c.lineTo(e.x, e.y);
        }
        c.stroke();

        for (const m of mods) {
          if (anim) {
            if (m.wait > 0) m.wait--;
            else {
              m.h += (m.to - m.h) * 0.02;
              if (Math.abs(m.to - m.h) < 0.04) {
                m.to = Math.random() < 0.3 ? rand(0.2, 0.7) : rand(0.9, 3.4);
                m.wait = rand(120, 900);
              }
            }
          }

          const h = Math.max(0.08, m.h);
          const t0 = iso(m.x, m.y, h);
          const t1 = iso(m.x + 1, m.y, h);
          const t2 = iso(m.x + 1, m.y + 1, h);
          const t3 = iso(m.x, m.y + 1, h);
          const b1 = iso(m.x + 1, m.y, 0);
          const b2 = iso(m.x + 1, m.y + 1, 0);
          const b3 = iso(m.x, m.y + 1, 0);

          const lift = Math.min(1, h / 3.4);
          const near = Math.max(0, 1 - Math.abs(m.d - wave) / 190);

          c.globalAlpha = 1;
          c.fillStyle = `rgba(${RED},${(0.035 + lift * 0.04 + near * 0.16).toFixed(3)})`;
          c.beginPath();
          c.moveTo(t0.x, t0.y);
          c.lineTo(t1.x, t1.y);
          c.lineTo(t2.x, t2.y);
          c.lineTo(t3.x, t3.y);
          c.closePath();
          c.fill();

          c.strokeStyle = `rgba(${RED},${(0.16 + lift * 0.14 + near * 0.5).toFixed(3)})`;
          c.stroke();

          c.strokeStyle = `rgba(${RED},${(0.09 + lift * 0.08 + near * 0.3).toFixed(3)})`;
          c.beginPath();
          c.moveTo(t1.x, t1.y);
          c.lineTo(b1.x, b1.y);
          c.moveTo(t2.x, t2.y);
          c.lineTo(b2.x, b2.y);
          c.moveTo(t3.x, t3.y);
          c.lineTo(b3.x, b3.y);
          c.moveTo(b1.x, b1.y);
          c.lineTo(b2.x, b2.y);
          c.lineTo(b3.x, b3.y);
          c.stroke();

          if (near > 0.04) {
            const cxp = (t0.x + t2.x) / 2;
            const cyp = (t0.y + t2.y) / 2;
            const r = 22 + near * 34;
            c.globalAlpha = near * 0.85;
            c.drawImage(roof, cxp - r, cyp - r, r * 2, r * 2);

            /* A beam off the taller ones as the light passes. */
            if (lift > 0.55) {
              const g = c.createLinearGradient(cxp, cyp, cxp, cyp - 240 * near);
              g.addColorStop(0, `rgba(255,90,105,${(near * 0.34).toFixed(3)})`);
              g.addColorStop(1, 'rgba(255,90,105,0)');
              c.fillStyle = g;
              c.fillRect(cxp - 7, cyp - 240 * near, 14, 240 * near);
              c.drawImage(spark, cxp - 5, cyp - 5, 10, 10);
            }
            c.globalAlpha = 1;
          }
        }
      };
    },
    { additive: true }
  );
</script>
