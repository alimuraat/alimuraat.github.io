---
/**
 * Projects — things being built, in isometric wireframe.
 *
 * A ground grid in isometric projection with modules standing on it. Modules
 * grow, hold, and come down again; nothing scrolls and nothing travels. Drawn
 * back to front so the overlaps read correctly.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  stage((k) => {
    const { c, W, H, anim, rand, RED } = k;

    const S = 46;
    const KX = S * 0.866;
    const KY = S * 0.5;
    const KZ = S * 0.62;

    /* Enough tiles that the diamond covers the viewport at any aspect. */
    const N = Math.ceil(Math.max(W / KX, H / KY) / 2) + 3;
    const ox = W * 0.5;
    const oy = H * 0.5 - N * 0.1 * KY;

    const iso = (x: number, y: number, z: number) => ({
      x: ox + (x - y) * KX,
      y: oy + (x + y) * KY - z * KZ,
    });

    type Mod = { x: number; y: number; h: number; to: number; wait: number };
    const mods: Mod[] = [];
    for (let x = -N; x <= N; x++) {
      for (let y = -N; y <= N; y++) {
        const p = iso(x, y, 0);
        if (p.x < -S * 2 || p.x > W + S * 2 || p.y < -S * 3 || p.y > H + S * 2) continue;
        if (Math.random() > 0.16) continue;
        const h = rand(0.4, 2.6);
        mods.push({ x, y, h, to: h, wait: rand(0, 500) });
      }
    }
    mods.sort((a, b) => a.x + a.y - (b.x + b.y));

    /* Ground grid, only where it is visible. */
    const lines: [number, number, number, number][] = [];
    for (let i = -N; i <= N; i++) {
      const a = iso(i, -N, 0);
      const b = iso(i, N, 0);
      lines.push([a.x, a.y, b.x, b.y]);
      const cc = iso(-N, i, 0);
      const d = iso(N, i, 0);
      lines.push([cc.x, cc.y, d.x, d.y]);
    }

    return () => {
      c.lineWidth = 1;

      c.strokeStyle = `rgba(${RED},.055)`;
      c.beginPath();
      for (const [x0, y0, x1, y1] of lines) {
        c.moveTo(x0, y0);
        c.lineTo(x1, y1);
      }
      c.stroke();

      for (const m of mods) {
        if (anim) {
          if (m.wait > 0) m.wait--;
          else {
            m.h += (m.to - m.h) * 0.02;
            if (Math.abs(m.to - m.h) < 0.04) {
              m.to = Math.random() < 0.3 ? rand(0.2, 0.6) : rand(0.8, 3);
              m.wait = rand(120, 900);
            }
          }
        }

        const h = Math.max(0.08, m.h);
        const t0 = iso(m.x, m.y, h);
        const t1 = iso(m.x + 1, m.y, h);
        const t2 = iso(m.x + 1, m.y + 1, h);
        const t3 = iso(m.x, m.y + 1, h);
        const b1 = iso(m.x + 1, m.y, 0);
        const b2 = iso(m.x + 1, m.y + 1, 0);
        const b3 = iso(m.x, m.y + 1, 0);

        const lift = Math.min(1, h / 3);

        /* Top face, faintly filled so the stack reads as solid. */
        c.fillStyle = `rgba(${RED},${(0.045 + lift * 0.05).toFixed(3)})`;
        c.beginPath();
        c.moveTo(t0.x, t0.y);
        c.lineTo(t1.x, t1.y);
        c.lineTo(t2.x, t2.y);
        c.lineTo(t3.x, t3.y);
        c.closePath();
        c.fill();
        c.strokeStyle = `rgba(${RED},${(0.16 + lift * 0.16).toFixed(3)})`;
        c.stroke();

        /* The two visible verticals and the front edges. */
        c.strokeStyle = `rgba(${RED},${(0.1 + lift * 0.1).toFixed(3)})`;
        c.beginPath();
        c.moveTo(t1.x, t1.y);
        c.lineTo(b1.x, b1.y);
        c.moveTo(t2.x, t2.y);
        c.lineTo(b2.x, b2.y);
        c.moveTo(t3.x, t3.y);
        c.lineTo(b3.x, b3.y);
        c.moveTo(b1.x, b1.y);
        c.lineTo(b2.x, b2.y);
        c.lineTo(b3.x, b3.y);
        c.stroke();
      }
    };
  });
</script>
