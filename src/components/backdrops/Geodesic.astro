---
/**
 * Travel — a geodesic sphere with great circles on it.
 *
 * An icosahedron subdivided twice and pushed out onto the unit sphere gives
 * 320 faces of almost equal area; drawing every edge, front and back, is what
 * produces the moire through the middle. The brighter arcs are real great
 * circles between the visited coordinates — slerped, so they take the short
 * way round the way a flight does.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  type V3 = [number, number, number];

  const CITIES: [number, number][] = [
    [35.68, 139.65],
    [34.69, 135.5],
    [52.37, 4.9],
    [48.86, 2.35],
    [48.14, 11.58],
    [41.9, 12.5],
    [41.39, 2.17],
    [40.42, -3.7],
    [41.01, 28.98],
    [39.93, 32.86],
    [37.07, 37.38],
  ];

  stage(
    (k) => {
      const { c, W, H, anim, RED } = k;

      const cx = W * 0.7;
      const cy = H * 0.44;
      const R = Math.min(W * 0.34, H * 0.42);

      const norm = (v: V3): V3 => {
        const l = Math.hypot(v[0], v[1], v[2]) || 1;
        return [v[0] / l, v[1] / l, v[2] / l];
      };

      /* Icosahedron, then two rounds of midpoint subdivision. */
      const PHI = 1.618034;
      let verts: V3[] = [];
      for (const s1 of [-1, 1]) {
        for (const s2 of [-PHI, PHI]) {
          verts.push([0, s1, s2], [s1, s2, 0], [s2, 0, s1]);
        }
      }
      verts = verts.map(norm);

      let faces: [number, number, number][] = [];
      for (let i = 0; i < verts.length; i++) {
        for (let j = i + 1; j < verts.length; j++) {
          for (let m = j + 1; m < verts.length; m++) {
            const d1 = Math.hypot(verts[i][0] - verts[j][0], verts[i][1] - verts[j][1], verts[i][2] - verts[j][2]);
            const d2 = Math.hypot(verts[j][0] - verts[m][0], verts[j][1] - verts[m][1], verts[j][2] - verts[m][2]);
            const d3 = Math.hypot(verts[i][0] - verts[m][0], verts[i][1] - verts[m][1], verts[i][2] - verts[m][2]);
            if (d1 < 1.06 && d2 < 1.06 && d3 < 1.06) faces.push([i, j, m]);
          }
        }
      }

      for (let pass = 0; pass < 2; pass++) {
        const next: [number, number, number][] = [];
        for (const [a, b, d] of faces) {
          const ab = verts.push(norm([(verts[a][0] + verts[b][0]) / 2, (verts[a][1] + verts[b][1]) / 2, (verts[a][2] + verts[b][2]) / 2])) - 1;
          const bd = verts.push(norm([(verts[b][0] + verts[d][0]) / 2, (verts[b][1] + verts[d][1]) / 2, (verts[b][2] + verts[d][2]) / 2])) - 1;
          const da = verts.push(norm([(verts[d][0] + verts[a][0]) / 2, (verts[d][1] + verts[a][1]) / 2, (verts[d][2] + verts[a][2]) / 2])) - 1;
          next.push([a, ab, da], [ab, b, bd], [da, bd, d], [ab, bd, da]);
        }
        faces = next;
      }

      /* Unique edges only, so each is drawn once. */
      const seen = new Set<string>();
      const edges: [number, number][] = [];
      for (const f of faces) {
        for (const [a, b] of [[f[0], f[1]], [f[1], f[2]], [f[2], f[0]]] as [number, number][]) {
          const key = a < b ? `${a}_${b}` : `${b}_${a}`;
          if (seen.has(key)) continue;
          seen.add(key);
          edges.push([a, b]);
        }
      }

      const RAD = Math.PI / 180;
      const toVec = ([lat, lon]: [number, number]): V3 => [
        Math.cos(lat * RAD) * Math.sin(lon * RAD),
        Math.sin(lat * RAD),
        Math.cos(lat * RAD) * Math.cos(lon * RAD),
      ];
      const pins = CITIES.map(toVec);
      const routes: [V3, V3][] = [];
      for (let i = 0; i < pins.length - 1; i++) routes.push([pins[i], pins[i + 1]]);

      let rot = 0;
      const px: number[] = [];
      const py: number[] = [];
      const pz: number[] = [];

      return () => {
        if (anim) rot += 0.0022;
        const s = Math.sin(rot);
        const co = Math.cos(rot);
        const tilt = 0.42;
        const st = Math.sin(tilt);
        const ct = Math.cos(tilt);

        for (let i = 0; i < verts.length; i++) {
          const [x0, y0, z0] = verts[i];
          const x1 = x0 * co + z0 * s;
          const z1 = -x0 * s + z0 * co;
          const y1 = y0 * ct - z1 * st;
          const z2 = y0 * st + z1 * ct;
          px[i] = cx + x1 * R;
          py[i] = cy - y1 * R;
          pz[i] = z2;
        }

        c.lineWidth = 1;
        c.beginPath();
        for (const [a, b] of edges) {
          if (pz[a] < 0 && pz[b] < 0) continue;
          c.moveTo(px[a], py[a]);
          c.lineTo(px[b], py[b]);
        }
        c.strokeStyle = `rgba(${RED},.13)`;
        c.stroke();

        c.beginPath();
        for (const [a, b] of edges) {
          if (pz[a] < 0.35 || pz[b] < 0.35) continue;
          c.moveTo(px[a], py[a]);
          c.lineTo(px[b], py[b]);
        }
        c.strokeStyle = `rgba(${RED},.22)`;
        c.stroke();

        /* Great circles, sampled by slerp. */
        const project = (v: V3) => {
          const x1 = v[0] * co + v[2] * s;
          const z1 = -v[0] * s + v[2] * co;
          const y1 = v[1] * ct - z1 * st;
          const z2 = v[1] * st + z1 * ct;
          return { x: cx + x1 * R * 1.01, y: cy - y1 * R * 1.01, z: z2 };
        };

        for (const [a, b] of routes) {
          const dot = Math.max(-1, Math.min(1, a[0] * b[0] + a[1] * b[1] + a[2] * b[2]));
          const om = Math.acos(dot);
          if (om < 0.001) continue;
          c.beginPath();
          let pen = false;
          for (let i = 0; i <= 40; i++) {
            const u = i / 40;
            const s1 = Math.sin((1 - u) * om) / Math.sin(om);
            const s2 = Math.sin(u * om) / Math.sin(om);
            const p = project([
              a[0] * s1 + b[0] * s2,
              a[1] * s1 + b[1] * s2,
              a[2] * s1 + b[2] * s2,
            ]);
            if (p.z < 0.02) {
              pen = false;
              continue;
            }
            if (!pen) {
              c.moveTo(p.x, p.y);
              pen = true;
            } else c.lineTo(p.x, p.y);
          }
          c.strokeStyle = `rgba(255,120,132,.5)`;
          c.stroke();
        }

        for (const v of pins) {
          const p = project(v);
          if (p.z < 0.02) continue;
          c.fillStyle = `rgba(255,190,196,${(0.35 + p.z * 0.5).toFixed(3)})`;
          c.fillRect(p.x - 1.5, p.y - 1.5, 3, 3);
        }
      };
    },
    { additive: true }
  );
</script>
