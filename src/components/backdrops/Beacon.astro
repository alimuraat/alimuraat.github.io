---
/**
 * Contact — a beacon.
 *
 * Streaks turn slowly around a core while messages fall in from the edges and
 * are absorbed with a flash. Every so often the core answers with a ring that
 * crosses the whole viewport.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  stage(
    (k) => {
      const { c, W, H, anim, rand, RED, glow } = k;

      const cx = W > 900 ? W * 0.7 : W * 0.5;
      const cy = H * 0.5;
      const reach = Math.hypot(W, H) * 0.55;

      const halo = glow(150, RED, 0.16);
      const core = glow(26, '255,180,186', 0.55);
      const bit = glow(9, '255,120,132', 0.7);
      const hit = glow(46, '255,220,224', 0.4);

      const streaks = Array.from({ length: 9 }, (_, i) => ({
        a: (i / 9) * 6.2832,
        sp: rand(0.0009, 0.0026) * (i % 2 ? -1 : 1),
        len: rand(0.5, 1),
        w: rand(6, 20),
      }));

      const msgs = Array.from({ length: 26 }, () => ({
        a: rand(0, 6.2832),
        d: rand(0.3, 1.4) * reach,
        v: rand(0.9, 2.6),
        flash: 0,
      }));

      const rings: { t: number }[] = [];
      let f = 0;

      return () => {
        f++;
        if (anim && f % 190 === 0) rings.push({ t: 0 });

        c.globalAlpha = 0.16;
        c.drawImage(halo, cx - 190, cy - 190, 380, 380);

        for (const s of streaks) {
          if (anim) s.a += s.sp;
          const g = c.createLinearGradient(
            cx,
            cy,
            cx + Math.cos(s.a) * reach * s.len,
            cy + Math.sin(s.a) * reach * s.len
          );
          g.addColorStop(0, `rgba(${RED},.07)`);
          g.addColorStop(1, `rgba(${RED},0)`);
          c.strokeStyle = g;
          c.lineWidth = s.w;
          c.globalAlpha = 0.18;
          c.beginPath();
          c.moveTo(cx, cy);
          c.lineTo(cx + Math.cos(s.a) * reach * s.len, cy + Math.sin(s.a) * reach * s.len);
          c.stroke();
        }
        c.lineWidth = 1;

        for (const m of msgs) {
          if (anim) {
            m.d -= m.v;
            if (m.flash > 0) m.flash -= 0.04;
            if (m.d < 14) {
              m.flash = 1;
              m.a = rand(0, 6.2832);
              m.d = rand(0.9, 1.5) * reach;
              m.v = rand(0.9, 2.6);
            }
          }
          const x = cx + Math.cos(m.a) * m.d;
          const y = cy + Math.sin(m.a) * m.d;
          c.globalAlpha = 0.5;
          c.drawImage(bit, x - 6, y - 6, 12, 12);
          if (m.flash > 0) {
            const r = 20 + (1 - m.flash) * 40;
            c.globalAlpha = m.flash * 0.6;
            c.drawImage(hit, cx - r, cy - r, r * 2, r * 2);
          }
        }

        for (let i = rings.length - 1; i >= 0; i--) {
          const r = rings[i];
          if (anim) r.t += 0.006;
          if (r.t >= 1) {
            rings.splice(i, 1);
            continue;
          }
          c.globalAlpha = (1 - r.t) * 0.5;
          c.strokeStyle = `rgba(${RED},.5)`;
          c.lineWidth = 2 - r.t;
          c.beginPath();
          c.arc(cx, cy, r.t * reach * 1.5, 0, 6.2832);
          c.stroke();
        }

        c.lineWidth = 1;
        c.globalAlpha = 0.18 + Math.sin(f * 0.05) * 0.06;
        c.drawImage(core, cx - 30, cy - 30, 60, 60);
        c.globalAlpha = 1;
      };
    },
    { trail: 0.14, additive: true }
  );
</script>
