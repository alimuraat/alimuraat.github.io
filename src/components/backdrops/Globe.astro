---
/**
 * Travel — a wireframe globe.
 *
 * Orthographic projection of a real sphere: meridians and parallels are
 * sampled in degrees, projected, and clipped to the visible hemisphere, so the
 * rotation is actual rotation rather than a scrolling texture. The markers are
 * the same coordinates the map on the page uses.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  /* A handful of the visited cities, in degrees. */
  const SITES: [number, number][] = [
    [35.68, 139.65],
    [34.69, 135.5],
    [52.37, 4.9],
    [48.86, 2.35],
    [48.14, 11.58],
    [41.9, 12.5],
    [41.39, 2.17],
    [40.42, -3.7],
    [41.01, 28.98],
    [39.93, 32.86],
    [37.07, 37.38],
    [38.42, 27.14],
  ];

  const RAD = Math.PI / 180;

  stage((k) => {
    const { c, W, H, anim, RED } = k;

    /* Offset and sized so the whole sphere reads as a sphere rather than as
       a few stray arcs, and so it sits beside the map instead of under it. */
    const cx = W * 0.74;
    const cy = H * 0.6;
    const R = Math.min(W, H) * 0.46;
    let rot = 0;

    const project = (lat: number, lon: number) => {
      const la = lat * RAD;
      const lo = (lon + rot) * RAD;
      const x = Math.cos(la) * Math.sin(lo);
      const y = Math.sin(la);
      const z = Math.cos(la) * Math.cos(lo);
      return { x: cx + x * R, y: cy - y * R, z };
    };

    /* Draws a sampled curve, breaking it wherever it goes round the back. */
    const curve = (pts: [number, number][], alpha: number) => {
      c.strokeStyle = `rgba(${RED},${alpha.toFixed(3)})`;
      c.beginPath();
      let pen = false;
      for (const [la, lo] of pts) {
        const p = project(la, lo);
        if (p.z <= 0.02) {
          pen = false;
          continue;
        }
        if (!pen) {
          c.moveTo(p.x, p.y);
          pen = true;
        } else c.lineTo(p.x, p.y);
      }
      c.stroke();
    };

    const meridians: [number, number][][] = [];
    for (let lon = 0; lon < 360; lon += 20) {
      const pts: [number, number][] = [];
      for (let lat = -90; lat <= 90; lat += 4) pts.push([lat, lon]);
      meridians.push(pts);
    }
    const parallels: [number, number][][] = [];
    for (let lat = -60; lat <= 60; lat += 20) {
      const pts: [number, number][] = [];
      for (let lon = 0; lon <= 360; lon += 4) pts.push([lat, lon]);
      parallels.push(pts);
    }

    return () => {
      if (anim) rot += 0.08;
      c.lineWidth = 1;

      c.strokeStyle = `rgba(${RED},.2)`;
      c.beginPath();
      c.arc(cx, cy, R, 0, 6.2832);
      c.stroke();

      for (const m of meridians) curve(m, 0.1);
      for (const p of parallels) curve(p, 0.1);
      curve(
        Array.from({ length: 91 }, (_, i) => [0, i * 4] as [number, number]),
        0.22
      );

      for (const [lat, lon] of SITES) {
        const p = project(lat, lon);
        if (p.z <= 0.02) continue;
        const a = Math.min(1, p.z * 1.6);
        c.fillStyle = `rgba(${RED},${(0.55 * a).toFixed(3)})`;
        c.beginPath();
        c.arc(p.x, p.y, 2, 0, 6.2832);
        c.fill();
        c.strokeStyle = `rgba(${RED},${(0.2 * a).toFixed(3)})`;
        c.beginPath();
        c.arc(p.x, p.y, 6, 0, 6.2832);
        c.stroke();
      }
    };
  });
</script>
