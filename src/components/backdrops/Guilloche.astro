---
/**
 * Certifications — guilloché.
 *
 * The engine-turned rosette that gets engraved on banknotes, passports and
 * certificates, for the same reason it is here: it is easy to verify and hard
 * to reproduce. Each band is a hypotrochoid —
 *
 *   x = (R−r)·cos t + d·cos((R−r)/r·t)
 *   y = (R−r)·sin t − d·sin((R−r)/r·t)
 *
 * — traced in a few thousand steps, and the bands counter-rotate at slightly
 * different rates so the moire between them never settles.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  stage(
    (k) => {
      const { c, W, H, anim, rand, RED } = k;

      const cx = W > 900 ? W * 0.7 : W * 0.5;
      const cy = H * 0.5;
      const R0 = Math.min(W * 0.34, H * 0.4);

      /* Whole-number R/r ratios close the curve; the small detune is what
         makes the pattern breathe instead of sitting still. */
      const bands = [
        { f: 1, teeth: 13, d: 0.72, sp: 0.0011, a: 0.2 },
        { f: 0.82, teeth: 21, d: 0.55, sp: -0.0007, a: 0.17 },
        { f: 0.64, teeth: 8, d: 0.86, sp: 0.0016, a: 0.15 },
        { f: 0.46, teeth: 34, d: 0.42, sp: -0.0021, a: 0.13 },
      ].map((b) => ({ ...b, phase: rand(0, 6.2832) }));

      const STEPS = 900;

      return () => {
        c.lineWidth = 1;

        for (const b of bands) {
          if (anim) b.phase += b.sp;

          const R = R0 * b.f;
          const r = R / b.teeth;
          const d = r * b.teeth * b.d * 0.32;

          c.strokeStyle = `rgba(${RED},${b.a})`;
          c.beginPath();
          for (let i = 0; i <= STEPS; i++) {
            const t = (i / STEPS) * 6.2832 * b.teeth + b.phase;
            const x = cx + (R - r) * Math.cos(t) + d * Math.cos(((R - r) / r) * t);
            const y = cy + (R - r) * Math.sin(t) - d * Math.sin(((R - r) / r) * t);
            if (i === 0) c.moveTo(x, y);
            else c.lineTo(x, y);
          }
          c.stroke();
        }

        /* Two plain rules to frame it, the way an engraving is always framed. */
        c.strokeStyle = `rgba(${RED},.16)`;
        for (const rr of [R0 * 1.02, R0 * 0.2]) {
          c.beginPath();
          c.arc(cx, cy, rr, 0, 6.2832);
          c.stroke();
        }
      };
    },
    { additive: true }
  );
</script>
