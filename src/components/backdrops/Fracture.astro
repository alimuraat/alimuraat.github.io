---
/**
 * Research — fracture propagation.
 *
 * A stress point opens and a hairline crack walks out of it, branching as it
 * goes, until it runs out of the viewport or out of energy. Then it holds,
 * anneals away, and the next one starts somewhere else. Breaking something and
 * watching where it gives is the job; this is that, drawn.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  stage((k) => {
    const { c, W, H, anim, rand, RED } = k;

    const CAP = 260;

    type Seg = { x0: number; y0: number; x1: number; y1: number; born: number; gen: number };
    type Tip = { x: number; y: number; a: number; life: number; gen: number };
    type Crack = {
      ox: number;
      oy: number;
      segs: Seg[];
      tips: Tip[];
      f: number;
      state: 0 | 1 | 2;
      alpha: number;
    };

    const spawn = (): Crack => {
      const ox = rand(W * 0.08, W * 0.92);
      const oy = rand(H * 0.08, H * 0.92);
      const arms = 2 + ((Math.random() * 3) | 0);
      const base = Math.random() * 6.2832;
      return {
        ox,
        oy,
        segs: [],
        tips: Array.from({ length: arms }, (_, i) => ({
          x: ox,
          y: oy,
          a: base + (i / arms) * 6.2832 + rand(-0.4, 0.4),
          life: 30 + ((Math.random() * 50) | 0),
          gen: 0,
        })),
        f: 0,
        state: 0,
        alpha: 1,
      };
    };

    const cracks: Crack[] = [spawn(), spawn(), spawn(), spawn()];
    /* Stagger them so the page is never between cracks. */
    cracks[1].f = 220;
    cracks[2].f = 440;
    cracks[3].f = 660;

    return () => {
      c.lineWidth = 1;

      for (let i = cracks.length - 1; i >= 0; i--) {
        const cr = cracks[i];
        if (anim) cr.f++;

        if (anim && cr.state === 0) {
          for (let t = cr.tips.length - 1; t >= 0; t--) {
            const tip = cr.tips[t];
            const step = rand(7, 17);
            tip.a += rand(-0.34, 0.34);
            const nx = tip.x + Math.cos(tip.a) * step;
            const ny = tip.y + Math.sin(tip.a) * step;
            cr.segs.push({ x0: tip.x, y0: tip.y, x1: nx, y1: ny, born: cr.f, gen: tip.gen });
            tip.x = nx;
            tip.y = ny;
            tip.life--;

            if (tip.gen < 3 && Math.random() < 0.045) {
              cr.tips.push({
                x: nx,
                y: ny,
                a: tip.a + (Math.random() < 0.5 ? -1 : 1) * rand(0.45, 0.95),
                life: (tip.life * 0.7) | 0,
                gen: tip.gen + 1,
              });
            }

            if (
              tip.life <= 0 ||
              nx < -40 ||
              nx > W + 40 ||
              ny < -40 ||
              ny > H + 40 ||
              cr.segs.length > CAP
            ) {
              cr.tips.splice(t, 1);
            }
          }
          if (!cr.tips.length || cr.segs.length > CAP) cr.state = 1;
        } else if (anim && cr.state === 1) {
          if (cr.f > 520) cr.state = 2;
        } else if (anim && cr.state === 2) {
          cr.alpha -= 0.006;
          if (cr.alpha <= 0) {
            cracks[i] = spawn();
            continue;
          }
        }

        /* The crack itself: fine where it has settled, bright at the tips. */
        for (const s of cr.segs) {
          const age = cr.f - s.born;
          const hot = Math.max(0, 1 - age / 26);
          const depth = 1 - s.gen * 0.22;
          c.strokeStyle = `rgba(${RED},${((0.22 * depth + hot * 0.5) * cr.alpha).toFixed(3)})`;
          c.beginPath();
          c.moveTo(s.x0, s.y0);
          c.lineTo(s.x1, s.y1);
          c.stroke();
        }

        /* Stress rings at the origin, once, as it opens. */
        if (cr.f < 80) {
          const u = cr.f / 80;
          c.strokeStyle = `rgba(${RED},${((1 - u) * 0.35 * cr.alpha).toFixed(3)})`;
          c.beginPath();
          c.arc(cr.ox, cr.oy, 6 + u * 90, 0, 6.2832);
          c.stroke();
        }
        c.fillStyle = `rgba(255,170,180,${(0.5 * cr.alpha).toFixed(3)})`;
        c.fillRect(cr.ox - 1.5, cr.oy - 1.5, 3, 3);

        for (const tip of cr.tips) {
          const g = c.createRadialGradient(tip.x, tip.y, 0, tip.x, tip.y, 12);
          g.addColorStop(0, `rgba(255,90,105,${(0.4 * cr.alpha).toFixed(3)})`);
          g.addColorStop(1, `rgba(${RED},0)`);
          c.fillStyle = g;
          c.beginPath();
          c.arc(tip.x, tip.y, 12, 0, 6.2832);
          c.fill();
        }
      }
    };
  });
</script>
