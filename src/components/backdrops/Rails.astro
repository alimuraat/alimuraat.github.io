---
/**
 * Experience — light running along rails.
 *
 * Packets accelerate down parallel rails leaving trails behind them, and every
 * time one reaches a station it blooms. Velocity along a track: the same route
 * the page in front of it is written as.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  stage(
    (k) => {
      const { c, W, H, anim, rand, RED, glow } = k;

      const rails = Math.max(6, Math.min(20, Math.round(H / 78)));
      const head = glow(16, '255,120,132', 0.75);
      const burst = glow(52, RED, 0.4);
      const dot = glow(4, '255,225,228', 0.9);

      const lanes = Array.from({ length: rails }, (_, i) => {
        const y = (H / rails) * (i + 0.5);
        return {
          y,
          stops: Array.from({ length: 3 }, () => rand(W * 0.1, W * 0.9)),
          flash: [] as { x: number; t: number }[],
          pk: Array.from({ length: 1 + ((Math.random() * 2) | 0) }, () => ({
            x: Math.random() * W,
            v: rand(1.4, 4.2),
            a: rand(0.0006, 0.0022),
            len: rand(40, 140),
          })),
        };
      });

      return () => {
        for (const lane of lanes) {
          c.globalAlpha = 1;
          c.fillStyle = `rgba(${RED},.012)`;
          c.fillRect(0, lane.y - 0.5, W, 1);

          for (const s of lane.stops) {
            c.globalAlpha = 0.16;
            c.drawImage(dot, s - 2.5, lane.y - 2.5, 5, 5);
          }

          for (const p of lane.pk) {
            if (anim) {
              p.v += p.a;
              const was = p.x;
              p.x += p.v;
              if (p.x > W + 60) {
                p.x = -60;
                p.v = rand(1.2, 3);
                p.len = rand(40, 140);
              } else {
                for (const s of lane.stops) {
                  if (was <= s && p.x > s) lane.flash.push({ x: s, t: 0 });
                }
              }
            }

            /* The streak is a handful of blits along the tail. */
            const steps = 7;
            for (let i = steps; i >= 0; i--) {
              const u = i / steps;
              const x = p.x - u * p.len;
              const r = 5 + (1 - u) * 9;
              c.globalAlpha = (1 - u) * 0.5;
              c.drawImage(head, x - r, lane.y - r, r * 2, r * 2);
            }
            c.globalAlpha = 1;
            c.drawImage(dot, p.x - 3, lane.y - 3, 6, 6);
          }

          for (let i = lane.flash.length - 1; i >= 0; i--) {
            const fl = lane.flash[i];
            if (anim) fl.t += 0.022;
            if (fl.t >= 1) {
              lane.flash.splice(i, 1);
              continue;
            }
            const r = 14 + fl.t * 90;
            c.globalAlpha = (1 - fl.t) * 0.5;
            c.drawImage(burst, fl.x - r, lane.y - r, r * 2, r * 2);
          }
        }
        c.globalAlpha = 1;
      };
    },
    { trail: 0.16, additive: true }
  );
</script>
