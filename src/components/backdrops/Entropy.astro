---
/**
 * Contact — plaintext turning into ciphertext.
 *
 * Each band is a signal. A boundary moves across it; to the left of the
 * boundary the signal is dense high-entropy noise, to the right it is the
 * readable low-amplitude wave it started as. Bands convert at their own pace
 * and restart when they finish.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  stage((k) => {
    const { c, W, H, anim, rand, RED, mono } = k;

    const BAND = 96;
    const count = Math.max(3, Math.floor(H / BAND));
    const step = 4;
    const cells = Math.ceil(W / step) + 1;

    const bands = Array.from({ length: count }, (_, i) => ({
      y: (H / count) * (i + 0.5),
      edge: Math.random() * W,
      sp: rand(0.25, 0.75),
      phase: Math.random() * 6.2832,
      freq: rand(0.6, 1.5),
      noise: Array.from({ length: cells }, () => Math.random() * 2 - 1),
      wait: 0,
    }));

    let f = 0;

    return () => {
      f++;
      c.lineWidth = 1;
      c.font = mono(9);
      c.textBaseline = 'middle';

      for (const b of bands) {
        if (anim) {
          if (b.edge < W) b.edge += b.sp;
          else if (b.wait < 180) b.wait++;
          else {
            b.edge = 0;
            b.wait = 0;
            b.phase = Math.random() * 6.2832;
            b.freq = rand(0.6, 1.5);
            for (let i = 0; i < cells; i++) b.noise[i] = Math.random() * 2 - 1;
          }
          if (f % 4 === 0) {
            /* Keep the ciphertext side alive without redrawing the whole band. */
            const i = (Math.random() * cells) | 0;
            b.noise[i] = Math.random() * 2 - 1;
          }
        }

        const amp = BAND * 0.3;

        /* Readable side: a calm wave. */
        c.strokeStyle = `rgba(150,150,162,.16)`;
        c.beginPath();
        for (let i = 0; i < cells; i++) {
          const x = i * step;
          if (x < b.edge) continue;
          const y = b.y + Math.sin((x / W) * 9 * b.freq + b.phase) * amp * 0.42;
          if (x - step < b.edge) c.moveTo(x, y);
          else c.lineTo(x, y);
        }
        c.stroke();

        /* Encrypted side: uniform noise, drawn as ticks rather than a line. */
        for (let i = 0; i < cells; i++) {
          const x = i * step;
          if (x >= b.edge) break;
          const h = b.noise[i] * amp;
          c.strokeStyle = `rgba(${RED},${(0.075 + Math.abs(b.noise[i]) * 0.11).toFixed(3)})`;
          c.beginPath();
          c.moveTo(x, b.y);
          c.lineTo(x, b.y + h);
          c.stroke();
        }

        /* The boundary itself. */
        if (b.edge < W) {
          c.strokeStyle = `rgba(255,150,160,.5)`;
          c.beginPath();
          c.moveTo(b.edge, b.y - amp - 6);
          c.lineTo(b.edge, b.y + amp + 6);
          c.stroke();
          c.fillStyle = `rgba(${RED},.34)`;
          c.fillText('aes-256-gcm', b.edge + 7, b.y - amp - 12);
        }
      }
    };
  });
</script>
