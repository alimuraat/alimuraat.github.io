---
/**
 * Certifications — a mechanism coming into alignment.
 *
 * Notched rings turn at their own rates, then their key notches converge on
 * the same mark, hold there for a beat, and release again. Not a chart of a
 * score — an instrument being brought into tolerance, which is what an audit
 * actually is.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  stage((k) => {
    const { c, W, H, anim, rand, RED } = k;

    const cx = W > 900 ? W * 0.68 : W * 0.5;
    const cy = H * 0.5;
    const R = Math.min(W * 0.28, H * 0.32);
    const TARGET = -1.5708; /* straight up */

    type Ring = { r: number; a: number; sp: number; teeth: number; key: number };
    const rings: Ring[] = [0.34, 0.5, 0.66, 0.82].map((f, i) => ({
      r: R * f,
      a: Math.random() * 6.2832,
      sp: (i % 2 ? -1 : 1) * rand(0.0035, 0.0075),
      teeth: 12 + i * 8,
      key: rand(0, 6.2832),
    }));

    let phase: 0 | 1 | 2 = 0; /* spin · converge · locked */
    let timer = 0;
    let pulse = -1;
    let f = 0;

    return () => {
      f++;
      c.lineWidth = 1;

      if (anim) {
        timer++;
        if (phase === 0) {
          for (const g of rings) g.a += g.sp;
          if (timer > 420) {
            phase = 1;
            timer = 0;
          }
        } else if (phase === 1) {
          let done = true;
          for (const g of rings) {
            /* Ease the key notch onto the mark by the shortest way round. */
            let want = TARGET - g.key;
            let d = want - g.a;
            while (d > 3.1416) d -= 6.2832;
            while (d < -3.1416) d += 6.2832;
            g.a += d * 0.045;
            if (Math.abs(d) > 0.012) done = false;
          }
          if (done) {
            phase = 2;
            timer = 0;
            pulse = f;
          }
        } else {
          if (timer > 150) {
            phase = 0;
            timer = 0;
            for (const g of rings) g.sp = (Math.random() < 0.5 ? -1 : 1) * rand(0.0035, 0.0085);
          }
        }
      }

      const lock = phase === 2 ? 1 : phase === 1 ? 0.4 : 0;

      /* Bezel with graduations. */
      c.strokeStyle = `rgba(${RED},.26)`;
      c.beginPath();
      c.arc(cx, cy, R, 0, 6.2832);
      c.stroke();
      c.strokeStyle = `rgba(${RED},.2)`;
      for (let i = 0; i < 120; i++) {
        const a = (i / 120) * 6.2832;
        const len = i % 10 === 0 ? 12 : 5;
        c.beginPath();
        c.moveTo(cx + Math.cos(a) * R, cy + Math.sin(a) * R);
        c.lineTo(cx + Math.cos(a) * (R - len), cy + Math.sin(a) * (R - len));
        c.stroke();
      }

      /* The mark everything is brought to. */
      c.strokeStyle = `rgba(255,150,160,${(0.3 + lock * 0.5).toFixed(3)})`;
      c.beginPath();
      c.moveTo(cx + Math.cos(TARGET) * (R + 14), cy + Math.sin(TARGET) * (R + 14));
      c.lineTo(cx + Math.cos(TARGET) * (R - 26), cy + Math.sin(TARGET) * (R - 26));
      c.stroke();

      for (const g of rings) {
        c.strokeStyle = `rgba(${RED},${(0.2 + lock * 0.12).toFixed(3)})`;
        c.beginPath();
        c.arc(cx, cy, g.r, 0, 6.2832);
        c.stroke();

        c.strokeStyle = `rgba(${RED},${(0.3 + lock * 0.16).toFixed(3)})`;
        for (let i = 0; i < g.teeth; i++) {
          const a = g.a + (i / g.teeth) * 6.2832;
          c.beginPath();
          c.moveTo(cx + Math.cos(a) * g.r, cy + Math.sin(a) * g.r);
          c.lineTo(cx + Math.cos(a) * (g.r - 9), cy + Math.sin(a) * (g.r - 9));
          c.stroke();
        }

        /* The key notch. */
        const ka = g.a + g.key;
        c.strokeStyle = `rgba(255,150,160,${(0.45 + lock * 0.45).toFixed(3)})`;
        c.beginPath();
        c.moveTo(cx + Math.cos(ka) * (g.r + 6), cy + Math.sin(ka) * (g.r + 6));
        c.lineTo(cx + Math.cos(ka) * (g.r - 14), cy + Math.sin(ka) * (g.r - 14));
        c.stroke();
        c.fillStyle = `rgba(255,150,160,${(0.5 + lock * 0.4).toFixed(3)})`;
        c.fillRect(cx + Math.cos(ka) * g.r - 2, cy + Math.sin(ka) * g.r - 2, 4, 4);
      }

      /* Hub. */
      c.strokeStyle = `rgba(${RED},${(0.32 + lock * 0.3).toFixed(3)})`;
      c.strokeRect(cx - 7, cy - 7, 14, 14);
      c.beginPath();
      c.moveTo(cx - 14, cy);
      c.lineTo(cx - 9, cy);
      c.moveTo(cx + 9, cy);
      c.lineTo(cx + 14, cy);
      c.moveTo(cx, cy - 14);
      c.lineTo(cx, cy - 9);
      c.moveTo(cx, cy + 9);
      c.lineTo(cx, cy + 14);
      c.stroke();

      /* It engages. */
      if (pulse > 0) {
        const u = (f - pulse) / 110;
        if (u < 1) {
          c.strokeStyle = `rgba(${RED},${((1 - u) * 0.4).toFixed(3)})`;
          c.beginPath();
          c.arc(cx, cy, 20 + u * (R + 90), 0, 6.2832);
          c.stroke();
        }
      }
    };
  });
</script>
