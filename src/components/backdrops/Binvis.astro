---
/**
 * Home — an address space on a Hilbert curve.
 *
 * This is how people who take binaries apart actually look at them: lay the
 * bytes along a space-filling curve, so anything close in the file stays close
 * on screen, and colour by entropy. Flat regions are code and padding; the
 * bright bands are compressed or encrypted, and finding those bands is usually
 * the first interesting thing you learn about a file.
 *
 * The pointer is a read head. Whatever region it is over lights up and reports
 * its offset and entropy, and a click sends a scan running along the curve
 * from there.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  /* Hilbert index -> cell, and back. Standard bit-twiddling both ways. */
  function d2xy(n: number, d: number): [number, number] {
    let t = d;
    let x = 0;
    let y = 0;
    for (let s = 1; s < n; s *= 2) {
      const rx = 1 & (t >> 1);
      const ry = 1 & (t ^ rx);
      if (ry === 0) {
        if (rx === 1) {
          x = s - 1 - x;
          y = s - 1 - y;
        }
        const tmp = x;
        x = y;
        y = tmp;
      }
      x += s * rx;
      y += s * ry;
      t >>= 2;
    }
    return [x, y];
  }

  function xy2d(n: number, ix: number, iy: number): number {
    let x = ix;
    let y = iy;
    let d = 0;
    for (let s = n >> 1; s > 0; s >>= 1) {
      const rx = (x & s) > 0 ? 1 : 0;
      const ry = (y & s) > 0 ? 1 : 0;
      d += s * s * ((3 * rx) ^ ry);
      if (ry === 0) {
        if (rx === 1) {
          x = s - 1 - x;
          y = s - 1 - y;
        }
        const tmp = x;
        x = y;
        y = tmp;
      }
    }
    return d;
  }

  stage(
    (k) => {
      const { c, W, H, anim, ptr, RED, mono } = k;

      const ORDER = 6;
      const SIDE = 1 << ORDER; /* 64 x 64 cells, 4096 of them */
      const TOTAL = SIDE * SIDE;
      const BLOCK = 32; /* cells per region, for the entropy readout */

      /* On a wide screen the map sits to the right of the column the copy
         lives in, so the two never fight; narrow screens get it centred. */
      const wide = W > 1000;
      const size = wide ? Math.min(W * 0.4, H * 0.66) : Math.min(W * 0.78, H * 0.5);
      const ox = (wide ? W * 0.73 : W * 0.5) - size / 2;
      const oy = H * 0.5 - size / 2;
      const cell = size / SIDE;

      const px = new Float32Array(TOTAL);
      const py = new Float32Array(TOTAL);
      for (let d = 0; d < TOTAL; d++) {
        const [x, y] = d2xy(SIDE, d);
        px[d] = ox + (x + 0.5) * cell;
        py[d] = oy + (y + 0.5) * cell;
      }

      /* A deterministic byte for every address, and the entropy of each block
         of them — the same summary a real map is coloured by. */
      const blocks = TOTAL / BLOCK;
      const ent = new Float32Array(blocks);
      let seed = 0x2f6e2b1;
      const next = () => {
        seed ^= seed << 13;
        seed ^= seed >>> 17;
        seed ^= seed << 5;
        return (seed >>> 0) / 4294967296;
      };
      for (let b = 0; b < blocks; b++) {
        /* Long flat stretches with occasional high-entropy bands, which is what
           a real file looks like. */
        const band = Math.sin(b * 0.11) * 0.5 + Math.sin(b * 0.037) * 0.5;
        ent[b] = Math.max(0, Math.min(1, 0.35 + band * 0.45 + (next() - 0.5) * 0.18));
      }

      /* Four alpha buckets so the whole curve is four paths rather than 4095
         strokes, and the membership is worked out once rather than per frame. */
      const BUCKETS = 4;
      const bucket: number[][] = Array.from({ length: BUCKETS }, () => []);
      for (let d = 1; d < TOTAL; d++) {
        const e = ent[(d / BLOCK) | 0];
        bucket[Math.min(BUCKETS - 1, (e * BUCKETS) | 0)].push(d);
      }

      let head = -1;
      let headAt = 0;
      let f = 0;
      let fx = W * 0.5;
      let fy = H * 0.5;

      return () => {
        f++;
        if (anim) ptr.idle++;
        const auto = !ptr.seen || ptr.idle > 260;

        /* With no pointer the read head walks the curve on its own. */
        const t = f * 0.0016;
        const tx = auto ? ox + size * (0.5 + Math.cos(t) * 0.34) : ptr.x;
        const ty = auto ? oy + size * (0.5 + Math.sin(t * 1.3) * 0.34) : ptr.y;
        fx += (tx - fx) * (anim ? 0.08 : 1);
        fy += (ty - fy) * (anim ? 0.08 : 1);

        const gx = Math.floor((fx - ox) / cell);
        const gy = Math.floor((fy - oy) / cell);
        const inside = gx >= 0 && gy >= 0 && gx < SIDE && gy < SIDE;
        const at = inside ? xy2d(SIDE, gx, gy) : -1;

        if (ptr.hit) {
          const hx = Math.floor((ptr.hit.x - ox) / cell);
          const hy = Math.floor((ptr.hit.y - oy) / cell);
          if (hx >= 0 && hy >= 0 && hx < SIDE && hy < SIDE) {
            head = xy2d(SIDE, hx, hy);
            headAt = f;
          }
          ptr.hit = null;
        }
        if (head >= 0 && anim) {
          head += 7;
          if (head >= TOTAL || f - headAt > 900) head = -1;
        }

        /* The map. */
        c.lineWidth = Math.max(1, cell * 0.5);
        c.lineCap = 'butt';
        for (let b = 0; b < BUCKETS; b++) {
          c.beginPath();
          for (const d of bucket[b]) {
            c.moveTo(px[d - 1], py[d - 1]);
            c.lineTo(px[d], py[d]);
          }
          const a = 0.035 + (b / (BUCKETS - 1)) * 0.14;
          c.strokeStyle = `rgba(${RED},${a.toFixed(3)})`;
          c.stroke();
        }

        /* Under the read head: the region reads back. */
        if (at >= 0) {
          const from = Math.max(1, at - 150);
          const to = Math.min(TOTAL - 1, at + 150);
          c.beginPath();
          for (let d = from; d <= to; d++) {
            c.moveTo(px[d - 1], py[d - 1]);
            c.lineTo(px[d], py[d]);
          }
          c.strokeStyle = `rgba(${RED},.38)`;
          c.stroke();

          c.beginPath();
          for (let d = Math.max(1, at - 34); d <= Math.min(TOTAL - 1, at + 34); d++) {
            c.moveTo(px[d - 1], py[d - 1]);
            c.lineTo(px[d], py[d]);
          }
          c.strokeStyle = `rgba(255,190,196,.62)`;
          c.stroke();

          const e = ent[(at / BLOCK) | 0];
          c.font = mono(10);
          c.textBaseline = 'middle';
          /* Flip the readout to the other side near the right edge. */
          const flip = px[at] > ox + size * 0.68;
          c.textAlign = flip ? 'right' : 'left';
          const lx = px[at] + (flip ? -14 : 14);
          c.fillStyle = `rgba(255,150,160,.75)`;
          c.fillText(`0x${(at * 64).toString(16).padStart(6, '0')}`, lx, py[at] - 8);
          c.fillStyle = `rgba(150,150,162,.55)`;
          c.fillText(`entropy ${e.toFixed(2)}`, lx, py[at] + 6);
          c.textAlign = 'left';

          c.strokeStyle = `rgba(${RED},.6)`;
          c.lineWidth = 1;
          c.strokeRect(px[at] - 6, py[at] - 6, 12, 12);
        }

        /* A click sends a scan along the curve. */
        if (head >= 0) {
          const tail = Math.max(1, head - 260);
          c.lineWidth = Math.max(1.4, cell * 0.7);
          for (let d = tail; d < Math.min(head, TOTAL); d += 4) {
            const u = (d - tail) / (head - tail || 1);
            c.strokeStyle = `rgba(255,190,196,${(u * 0.7).toFixed(3)})`;
            c.beginPath();
            c.moveTo(px[d - 1], py[d - 1]);
            c.lineTo(px[Math.min(d + 3, TOTAL - 1)], py[Math.min(d + 3, TOTAL - 1)]);
            c.stroke();
          }
        }

        /* Frame and scale, so it reads as a map of something. */
        c.lineWidth = 1;
        c.strokeStyle = `rgba(150,150,162,.16)`;
        c.strokeRect(ox - 0.5, oy - 0.5, size + 1, size + 1);
        c.font = mono(9);
        c.fillStyle = `rgba(150,150,162,.34)`;
        c.fillText('0x000000', ox, oy - 10);
        c.textAlign = 'right';
        c.fillText(`0x${(TOTAL * 64).toString(16)}`, ox + size, oy + size + 14);
        c.textAlign = 'left';
      };
    },
    { additive: false }
  );
</script>
