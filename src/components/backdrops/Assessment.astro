---
/**
 * Certifications — a maturity assessment, drawn as a radar.
 *
 * Eight axes, five rings, and a measured polygon that eases to a new set of
 * scores every few seconds. The only motion is the shape re-measuring itself.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  const AXES = ['a.5', 'a.6', 'a.7', 'a.8', '27001', '42001', 'sdlc', 'ir'];

  stage((k) => {
    const { c, W, H, anim, rand, RED, mono } = k;

    const n = AXES.length;
    const cx = W > 900 ? W * 0.78 : W * 0.5;
    const cy = H * 0.56;
    const R = Math.min(W * 0.3, H * 0.34);
    const RINGS = 5;

    const at = (i: number, r: number) => {
      const a = (i / n) * 6.2832 - 1.5708;
      return { x: cx + Math.cos(a) * r, y: cy + Math.sin(a) * r };
    };

    const val = Array.from({ length: n }, () => rand(0.4, 0.9));
    const to = val.slice();
    let wait = 0;

    return () => {
      c.lineWidth = 1;
      c.font = mono(9);
      c.textBaseline = 'middle';
      c.textAlign = 'center';

      if (anim) {
        if (wait > 0) wait--;
        else {
          let settled = true;
          for (let i = 0; i < n; i++) {
            val[i] += (to[i] - val[i]) * 0.03;
            if (Math.abs(to[i] - val[i]) > 0.01) settled = false;
          }
          if (settled) {
            for (let i = 0; i < n; i++) to[i] = rand(0.35, 0.97);
            wait = 260;
          }
        }
      }

      /* Rings and spokes. */
      for (let r = 1; r <= RINGS; r++) {
        c.strokeStyle = `rgba(${RED},${r === RINGS ? 0.2 : 0.085})`;
        c.beginPath();
        for (let i = 0; i <= n; i++) {
          const p = at(i % n, (R * r) / RINGS);
          if (i === 0) c.moveTo(p.x, p.y);
          else c.lineTo(p.x, p.y);
        }
        c.closePath();
        c.stroke();
      }

      c.strokeStyle = `rgba(${RED},.09)`;
      c.beginPath();
      for (let i = 0; i < n; i++) {
        const p = at(i, R);
        c.moveTo(cx, cy);
        c.lineTo(p.x, p.y);
      }
      c.stroke();

      /* The measurement. */
      c.beginPath();
      for (let i = 0; i <= n; i++) {
        const p = at(i % n, R * val[i % n]);
        if (i === 0) c.moveTo(p.x, p.y);
        else c.lineTo(p.x, p.y);
      }
      c.closePath();
      c.fillStyle = `rgba(${RED},.035)`;
      c.fill();
      c.strokeStyle = `rgba(${RED},.38)`;
      c.stroke();

      for (let i = 0; i < n; i++) {
        const p = at(i, R * val[i]);
        c.fillStyle = `rgba(255,150,160,.6)`;
        c.fillRect(p.x - 2, p.y - 2, 4, 4);

        const l = at(i, R + 18);
        c.fillStyle = `rgba(150,150,162,.3)`;
        c.fillText(AXES[i], l.x, l.y);
      }

      c.textAlign = 'left';
    };
  });
</script>
