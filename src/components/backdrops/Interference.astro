---
/**
 * Research — interference.
 *
 * Three sources drift across the viewport and the field between them is
 * sampled on a lattice: where the waves agree the lattice lights up, where
 * they cancel it goes dark. The moire that falls out of it never repeats.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  stage(
    (k) => {
      const { c, W, H, anim, rand, RED, glow } = k;

      const STEP = 22;
      const cols = Math.ceil(W / STEP) + 1;
      const rows = Math.ceil(H / STEP) + 1;
      const dot = glow(10, RED, 0.55);
      const peak = glow(6, '255,220,224', 0.9);

      const src = Array.from({ length: 3 }, () => ({
        x: 0,
        y: 0,
        px: rand(0, 6.2832),
        py: rand(0, 6.2832),
        sx: rand(0.0016, 0.0034),
        sy: rand(0.0016, 0.0034),
        k: rand(0.028, 0.05),
        w: rand(0.05, 0.09),
      }));

      let t = 0;

      return () => {
        if (anim) t += 1;

        for (const s of src) {
          s.x = W * 0.5 + Math.cos(t * s.sx + s.px) * W * 0.42;
          s.y = H * 0.5 + Math.sin(t * s.sy + s.py) * H * 0.42;
        }

        for (let r = 0; r < rows; r++) {
          const y = r * STEP;
          for (let i = 0; i < cols; i++) {
            const x = i * STEP;
            let v = 0;
            for (const s of src) {
              v += Math.sin(Math.hypot(x - s.x, y - s.y) * s.k - t * s.w);
            }
            v /= src.length;
            if (v < 0.06) continue;

            const rr = 1.6 + v * 7;
            c.globalAlpha = v * v * 0.45;
            c.drawImage(dot, x - rr, y - rr, rr * 2, rr * 2);
            if (v > 0.93) {
              c.globalAlpha = (v - 0.93) * 9;
              c.drawImage(peak, x - 3, y - 3, 6, 6);
            }
          }
        }
        c.globalAlpha = 1;
      };
    },
    { additive: true }
  );
</script>
