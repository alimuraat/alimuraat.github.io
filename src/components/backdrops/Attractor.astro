---
/**
 * Home — a de Jong attractor, steered by the pointer.
 *
 *   x' = sin(a·y) − cos(b·x)
 *   y' = sin(c·x) − cos(d·y)
 *
 * Iterating that a few thousand times a frame and adding a hair of light at
 * every landing builds a filigree that no single point explains. The pointer
 * moves two of the four constants, so the whole structure reorganises under
 * the cursor rather than anything following it. Left alone the constants drift
 * on their own.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  stage(
    (k) => {
      const { c, W, H, anim, ptr, RED } = k;

      const ITER = Math.max(2200, Math.min(9000, Math.round((W * H) / 82)));
      const scale = Math.min(W, H) * 0.33;
      const cx = W * 0.5;
      const cy = H * 0.47;

      /* Four constants; two are steered, two drift. */
      const p = [1.7, 1.7, 0.6, 1.2];
      const to = p.slice();
      let x = 0.1;
      let y = 0.1;
      let t = 0;

      return () => {
        t += 0.004;
        if (anim) ptr.idle++;
        const auto = !ptr.seen || ptr.idle > 240;

        to[0] = auto ? 1.6 + Math.sin(t * 0.9) * 0.9 : -3 + (ptr.x / W) * 6;
        to[1] = auto ? 1.7 + Math.cos(t * 0.7) * 0.9 : -3 + (ptr.y / H) * 6;
        to[2] = 0.7 + Math.sin(t * 0.53) * 1.1;
        to[3] = 1.2 + Math.cos(t * 0.41) * 1.1;
        for (let i = 0; i < 4; i++) p[i] += (to[i] - p[i]) * (anim ? 0.02 : 1);

        /* Two passes: the bulk at a hair of alpha, a sparser brighter pass on
           top, which is what gives the filigree its lit edges. */
        c.fillStyle = `rgba(${RED},.1)`;
        for (let i = 0; i < ITER; i++) {
          const nx = Math.sin(p[0] * y) - Math.cos(p[1] * x);
          const ny = Math.sin(p[2] * x) - Math.cos(p[3] * y);
          x = nx;
          y = ny;
          if (i > 12) c.fillRect(cx + x * scale, cy + y * scale, 1, 1);
        }

        c.fillStyle = 'rgba(255,190,196,.07)';
        for (let i = 0; i < ITER >> 3; i++) {
          const nx = Math.sin(p[0] * y) - Math.cos(p[1] * x);
          const ny = Math.sin(p[2] * x) - Math.cos(p[3] * y);
          x = nx;
          y = ny;
          c.fillRect(cx + x * scale, cy + y * scale, 1.2, 1.2);
        }
      };
    },
    { trail: 0.03, additive: true }
  );
</script>
