---
/**
 * Experience — an access log.
 *
 * Entries appear in fixed slots and fade out again; nothing scrolls and
 * nothing travels. The roles climb over the years the way the page in front
 * of it does, and every so often a line is a denial rather than a grant.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  const FACILITY = ['sshd', 'sudo', 'audit', 'pam', 'vault', 'iam', 'kbd', 'crond'];
  const GRANT = [
    'accepted publickey',
    'session opened',
    'role assumed',
    'mfa verified',
    'scope granted',
    'token issued',
    'policy attached',
  ];
  const DENY = [
    'permission denied',
    'mfa required',
    'policy blocked',
    'rate limited',
    'expired token',
  ];
  const SUBJECT = [
    'amt@borusan',
    'amt@pwc',
    'amt@teknasyon',
    'amt@sorgu',
    'amt@flokser',
    'amt@lab',
  ];
  const ROLE = ['analyst', 'engineer', 'consultant', 'lead auditor', 'senior engineer', 'root'];

  stage((k) => {
    const { c, W, H, anim, rand, RED, mono } = k;

    const LH = 26;
    const slots = Math.max(6, Math.floor(H / LH));
    const pad = Math.min(W * 0.06, 90);

    type Line = { x: number; ts: string; fac: string; msg: string; sub: string; deny: boolean; t: number; life: number };

    const make = (): Line => {
      const deny = Math.random() < 0.16;
      const h = (Math.random() * 24) | 0;
      const m = (Math.random() * 60) | 0;
      const s = (Math.random() * 60) | 0;
      const pad2 = (n: number) => String(n).padStart(2, '0');
      const grant = GRANT[(Math.random() * GRANT.length) | 0];
      return {
        x: pad + rand(0, Math.max(0, W * 0.35)),
        ts: `${pad2(h)}:${pad2(m)}:${pad2(s)}`,
        fac: FACILITY[(Math.random() * FACILITY.length) | 0],
        msg: deny
          ? DENY[(Math.random() * DENY.length) | 0]
          : Math.random() < 0.3
            ? `role -> ${ROLE[(Math.random() * ROLE.length) | 0]}`
            : grant,
        sub: SUBJECT[(Math.random() * SUBJECT.length) | 0],
        deny,
        t: rand(0, 0.6),
        life: rand(320, 620),
      };
    };

    const lines: (Line | null)[] = Array.from({ length: slots }, () =>
      Math.random() < 0.7 ? make() : null
    );

    return () => {
      c.font = mono(11);
      c.textBaseline = 'middle';

      for (let i = 0; i < slots; i++) {
        const l = lines[i];
        if (!l) {
          if (anim && Math.random() < 0.004) lines[i] = make();
          continue;
        }
        if (anim) {
          l.t += 1 / l.life;
          if (l.t >= 1) {
            lines[i] = Math.random() < 0.75 ? make() : null;
            continue;
          }
        }

        /* Fade in fast, hold, fade out slowly. */
        const a = l.t < 0.12 ? l.t / 0.12 : l.t > 0.7 ? (1 - l.t) / 0.3 : 1;
        const y = i * LH + LH * 0.5;
        let x = l.x;

        c.fillStyle = `rgba(150,150,162,${(a * 0.2).toFixed(3)})`;
        c.fillText(l.ts, x, y);
        x += c.measureText(l.ts).width + 12;

        c.fillStyle = `rgba(150,150,162,${(a * 0.15).toFixed(3)})`;
        c.fillText(`${l.fac}:`, x, y);
        x += c.measureText(`${l.fac}: `).width + 4;

        c.fillStyle = l.deny
          ? `rgba(240,160,32,${(a * 0.3).toFixed(3)})`
          : `rgba(${RED},${(a * 0.26).toFixed(3)})`;
        c.fillText(l.msg, x, y);
        x += c.measureText(l.msg).width + 12;

        c.fillStyle = `rgba(150,150,162,${(a * 0.16).toFixed(3)})`;
        c.fillText(l.sub, x, y);
      }
    };
  });
</script>
