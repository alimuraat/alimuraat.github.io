---
/**
 * Contact — key exchange.
 *
 * Two endpoints trade pulses across a channel that cuts the viewport
 * diagonally. Where the pulses pass each other a block seals and fades, and
 * every few rounds the session is established and a ring goes out from the
 * midpoint. Encrypted mail, drawn.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  stage((k) => {
    const { c, W, H, anim, rand, RED } = k;

    const A = { x: W * 0.12, y: H * 0.3 };
    const B = { x: W * 0.88, y: H * 0.72 };
    const mid = { x: (A.x + B.x) / 2, y: (A.y + B.y) / 2 };

    type Pulse = { u: number; dir: 1 | -1; sp: number };
    const pulses: Pulse[] = [{ u: 0, dir: 1, sp: rand(0.0055, 0.0085) }];
    const seals: { x: number; y: number; t: number }[] = [];
    const rings: { t: number }[] = [];
    let rounds = 0;
    let f = 0;

    const at = (u: number) => ({ x: A.x + (B.x - A.x) * u, y: A.y + (B.y - A.y) * u });
    const dist = Math.hypot(B.x - A.x, B.y - A.y);

    return () => {
      f++;
      c.lineWidth = 1;

      /* Quiet field so the corners are not empty. */
      for (let i = 1; i <= 4; i++) {
        c.strokeStyle = `rgba(${RED},.05)`;
        c.beginPath();
        c.arc(mid.x, mid.y, (i / 4) * Math.hypot(W, H) * 0.46, 0, 6.2832);
        c.stroke();
      }

      /* The channel and its tick marks. */
      c.strokeStyle = `rgba(${RED},.18)`;
      c.beginPath();
      c.moveTo(A.x, A.y);
      c.lineTo(B.x, B.y);
      c.stroke();
      const nx = -(B.y - A.y) / dist;
      const ny = (B.x - A.x) / dist;
      c.strokeStyle = `rgba(${RED},.14)`;
      for (let i = 1; i < 24; i++) {
        const p = at(i / 24);
        c.beginPath();
        c.moveTo(p.x - nx * 4, p.y - ny * 4);
        c.lineTo(p.x + nx * 4, p.y + ny * 4);
        c.stroke();
      }

      for (const e of [A, B]) {
        c.strokeStyle = `rgba(${RED},.4)`;
        c.strokeRect(e.x - 6, e.y - 6, 12, 12);
        c.fillStyle = `rgba(${RED},.5)`;
        c.fillRect(e.x - 2, e.y - 2, 4, 4);
      }

      for (let i = pulses.length - 1; i >= 0; i--) {
        const p = pulses[i];
        if (anim) p.u += p.sp * p.dir;

        if (p.u >= 1 || p.u <= 0) {
          const landed = p.u >= 1 ? B : A;
          rings.push({ t: 0 });
          rounds++;
          pulses.splice(i, 1);
          pulses.push({
            u: p.u >= 1 ? 1 : 0,
            dir: (p.dir === 1 ? -1 : 1) as 1 | -1,
            sp: rand(0.0055, 0.0085),
          });
          const s = at(p.u >= 1 ? 0.98 : 0.02);
          seals.push({ x: s.x, y: s.y, t: 0 });
          void landed;
          continue;
        }

        const pos = at(p.u);
        const g = c.createRadialGradient(pos.x, pos.y, 0, pos.x, pos.y, 16);
        g.addColorStop(0, 'rgba(255,90,105,.62)');
        g.addColorStop(1, `rgba(${RED},0)`);
        c.fillStyle = g;
        c.beginPath();
        c.arc(pos.x, pos.y, 16, 0, 6.2832);
        c.fill();
        c.fillStyle = 'rgba(255,205,210,.92)';
        c.fillRect(pos.x - 2, pos.y - 2, 4, 4);

        /* Trail. */
        for (let j = 1; j < 8; j++) {
          const u = p.u - p.dir * j * 0.012;
          if (u < 0 || u > 1) break;
          const q = at(u);
          c.fillStyle = `rgba(${RED},${(0.32 * (1 - j / 8)).toFixed(3)})`;
          c.fillRect(q.x - 1.2, q.y - 1.2, 2.4, 2.4);
        }
      }

      /* A block sealing: square turning to a diamond as it fades. */
      for (let i = seals.length - 1; i >= 0; i--) {
        const s = seals[i];
        if (anim) s.t += 0.012;
        if (s.t >= 1) {
          seals.splice(i, 1);
          continue;
        }
        c.save();
        c.translate(s.x, s.y);
        c.rotate(s.t * 0.7854);
        c.strokeStyle = `rgba(${RED},${((1 - s.t) * 0.5).toFixed(3)})`;
        const r = 5 + s.t * 9;
        c.strokeRect(-r, -r, r * 2, r * 2);
        c.restore();
      }

      for (let i = rings.length - 1; i >= 0; i--) {
        const r = rings[i];
        if (anim) r.t += 0.008;
        if (r.t >= 1) {
          rings.splice(i, 1);
          continue;
        }
        c.strokeStyle = `rgba(${RED},${((1 - r.t) * 0.28).toFixed(3)})`;
        c.beginPath();
        c.arc(mid.x, mid.y, r.t * Math.hypot(W, H) * 0.5, 0, 6.2832);
        c.stroke();
      }

      void rounds;
    };
  });
</script>
