---
/**
 * Certifications — a control matrix being assessed.
 *
 * An assessment cursor walks the matrix cell by cell. Most controls come back
 * conformant, some are left as gaps, a few as nonconformities. When the sweep
 * reaches the end the matrix clears and the next assessment starts. No lines,
 * no travelling anything — just the grid filling in.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  stage((k) => {
    const { c, W, H, anim, RED, mono } = k;

    const PITCH = 26;
    const CELL = 20;
    const TOP = 34;
    const pad = Math.min(70, W * 0.05);

    const cols = Math.max(6, Math.floor((W - pad * 2) / PITCH));
    const rows = Math.max(4, Math.floor((H - TOP - 20) / PITCH));
    const total = cols * rows;

    /* 0 unassessed · 1 conformant · 2 gap · 3 nonconformity */
    const cells = new Uint8Array(total);
    let cursor = 0;
    let hold = 0;
    let fade = 0;
    let sub = 0;

    const x0 = pad;
    const cx = (i: number) => x0 + (i % cols) * PITCH;
    const cy = (i: number) => TOP + Math.floor(i / cols) * PITCH;

    return () => {
      c.lineWidth = 1;
      c.font = mono(9);
      c.textBaseline = 'middle';

      if (anim) {
        if (cursor < total) {
          sub += 0.42;
          while (sub >= 1 && cursor < total) {
            sub -= 1;
            const r = Math.random();
            cells[cursor] = r > 0.95 ? 3 : r > 0.82 ? 2 : 1;
            cursor++;
          }
        } else if (hold < 220) hold++;
        else {
          fade += 0.012;
          if (fade >= 1) {
            cells.fill(0);
            cursor = 0;
            hold = 0;
            fade = 0;
          }
        }
      }

      const alive = 1 - fade;

      /* Domain headers along the top and row numbers down the side. */
      c.fillStyle = `rgba(150,150,162,${(0.22 * alive).toFixed(3)})`;
      for (let i = 0; i < cols; i += 4) {
        c.fillText(`A.${5 + ((i / 4) % 4)}`, x0 + i * PITCH, TOP - 16);
      }
      for (let r = 0; r < rows; r += 4) {
        c.fillText(String(r + 1).padStart(2, '0'), x0 - 22, cy(r * cols) + CELL / 2);
      }

      for (let i = 0; i < total; i++) {
        const s = cells[i];
        const x = cx(i);
        const y = cy(i);
        if (s === 0) {
          c.strokeStyle = `rgba(150,150,162,${(0.08 * alive).toFixed(3)})`;
          c.strokeRect(x + 0.5, y + 0.5, CELL, CELL);
          continue;
        }
        if (s === 1) {
          c.fillStyle = `rgba(${RED},${(0.1 * alive).toFixed(3)})`;
          c.fillRect(x, y, CELL, CELL);
          c.strokeStyle = `rgba(${RED},${(0.2 * alive).toFixed(3)})`;
          c.strokeRect(x + 0.5, y + 0.5, CELL, CELL);
        } else if (s === 2) {
          c.strokeStyle = `rgba(150,150,162,${(0.26 * alive).toFixed(3)})`;
          c.strokeRect(x + 0.5, y + 0.5, CELL, CELL);
        } else {
          c.strokeStyle = `rgba(240,160,32,${(0.5 * alive).toFixed(3)})`;
          c.strokeRect(x + 0.5, y + 0.5, CELL, CELL);
          c.beginPath();
          c.moveTo(x + 5, y + 5);
          c.lineTo(x + CELL - 5, y + CELL - 5);
          c.moveTo(x + CELL - 5, y + 5);
          c.lineTo(x + 5, y + CELL - 5);
          c.stroke();
        }
      }

      /* The cursor: the cell being assessed, and its row. */
      if (cursor < total) {
        const x = cx(cursor);
        const y = cy(cursor);
        c.fillStyle = `rgba(${RED},.07)`;
        c.fillRect(x0, y, cols * PITCH - (PITCH - CELL), CELL);
        c.strokeStyle = `rgba(255,150,160,.55)`;
        c.strokeRect(x - 1.5, y - 1.5, CELL + 3, CELL + 3);
      }
    };
  });
</script>
