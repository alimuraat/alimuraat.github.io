---
/**
 * The inner pages: one panel each, drawn from the tools of the trade rather
 * than from the film version of them. No falling glyphs, no green terminal, no
 * padlocks.
 *
 *   flame     — a flame graph, the way you read where time actually goes
 *   fuzz      — a coverage bitmap filling in, with the odd crash
 *   treemap   — a squarified treemap, how you see what a codebase is made of
 *   avalanche — flip one input bit and watch the digest come apart
 *   azimuth   — azimuthal-equidistant plot, ranges measured from Istanbul
 *   randomart — the drunken bishop, walked out as it is for a key fingerprint
 *
 * They sit centred behind the column, drawn low enough in contrast that the
 * copy always wins. No frame and no caption box: a bordered widget in a corner
 * reads as a widget rather than as the page having a subject.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  type Kind = 'flame' | 'fuzz' | 'treemap' | 'avalanche' | 'azimuth' | 'randomart';

  const CAPTION: Record<Kind, string> = {
    flame: 'where the time went',
    fuzz: 'coverage · crashes',
    treemap: 'what it is made of',
    avalanche: 'sha-256 · avalanche',
    azimuth: 'range from istanbul',
    randomart: 'key fingerprint',
  };

  stage(
    (k) => {
      const { c, W, H, anim, rand, RED, mono } = k;
      const kind = ((document.getElementById('net') as HTMLCanvasElement).dataset.variant ??
        'flame') as Kind;

      const GREY = '150,150,162';
      /* Centred behind the column rather than beside it: at 1180px of content
         there is no room for a side panel on an ordinary screen, and a boxed
         widget in the corner reads as a widget. Low contrast does the work. */
      const bw = Math.min(W * 0.66, 820);
      const ratio: Record<Kind, number> = {
        flame: 0.72,
        fuzz: 0.66,
        treemap: 0.78,
        avalanche: 0.5,
        azimuth: 1,
        randomart: 0.62,
      };
      const bh = bw * ratio[kind];
      const bx = W * 0.5 - bw / 2;
      const by = H * 0.5 - bh / 2;

      let f = 0;

      /* ---------------------------------------------------------- flame --- */
      type Frame = { x: number; w: number; d: number; grow: number };
      const frames: Frame[] = [];
      const buildFlame = () => {
        frames.length = 0;
        const split = (x: number, w: number, d: number) => {
          frames.push({ x, w, d, grow: 0 });
          if (d > 4 || w < 0.06) return;
          let at = x + w * rand(0.01, 0.06);
          const room = x + w;
          while (at < room - w * 0.08) {
            const cw = Math.min(room - at, w * rand(0.18, 0.55));
            split(at, cw, d + 1);
            at += cw + w * rand(0.01, 0.05);
          }
        };
        split(0, 1, 0);
      };

      /* ----------------------------------------------------------- fuzz --- */
      const FC = 26;
      const FR = 16;
      const cov = new Uint8Array(FC * FR);
      const crash: number[] = [];
      let paths = 0;

      /* -------------------------------------------------------- treemap --- */
      type Tile = { x: number; y: number; w: number; h: number; tx: number; ty: number; tw: number; th: number };
      const tiles: Tile[] = [];
      const layout = (first: boolean) => {
        /* Slice-and-dice is enough at this size and stays readable. */
        const areas = Array.from({ length: 13 }, () => rand(0.4, 3));
        const total = areas.reduce((a, b) => a + b, 0);
        let x = 0;
        let y = 0;
        let free = 1;
        let vertical = true;
        let rest = total;
        areas.forEach((a, i) => {
          const share = a / rest;
          const last = i === areas.length - 1;
          const w = vertical ? (last ? 1 - x : share * free) : 1 - x;
          const h = vertical ? 1 - y : last ? 1 - y : share * free;
          const t = tiles[i] ?? { x, y, w, h, tx: x, ty: y, tw: w, th: h };
          t.tx = x;
          t.ty = y;
          t.tw = Math.max(0.02, w);
          t.th = Math.max(0.02, h);
          if (first) {
            t.x = t.tx;
            t.y = t.ty;
            t.w = t.tw;
            t.h = t.th;
          }
          tiles[i] = t;
          if (vertical) x += w;
          else y += h;
          rest -= a;
          free = 1 - (vertical ? x : y);
          if (i % 3 === 2) vertical = !vertical;
        });
      };

      /* ------------------------------------------------------ avalanche --- */
      const BITS = 64;
      let digest = Array.from({ length: BITS }, () => (Math.random() < 0.5 ? 0 : 1));
      let nextDigest = digest.slice();
      let flipped = -1;
      let mix = 1;

      /* -------------------------------------------------------- azimuth --- */
      const RAD = Math.PI / 180;
      const HOME: [number, number] = [41.01, 28.98];
      const CITIES: [number, number, string][] = [
        [35.68, 139.65, 'tokyo'],
        [34.69, 135.5, 'osaka'],
        [52.37, 4.9, 'amsterdam'],
        [48.86, 2.35, 'paris'],
        [48.14, 11.58, 'munich'],
        [41.9, 12.5, 'rome'],
        [41.39, 2.17, 'barcelona'],
        [40.42, -3.7, 'madrid'],
        [39.93, 32.86, 'ankara'],
        [37.07, 37.38, 'gaziantep'],
        [38.42, 27.14, 'izmir'],
      ];
      const polar = CITIES.map(([lat, lon, name]) => {
        const p1 = HOME[0] * RAD;
        const p2 = lat * RAD;
        const dl = (lon - HOME[1]) * RAD;
        const dist =
          Math.acos(
            Math.min(1, Math.sin(p1) * Math.sin(p2) + Math.cos(p1) * Math.cos(p2) * Math.cos(dl))
          ) * 6371;
        const brg = Math.atan2(
          Math.sin(dl) * Math.cos(p2),
          Math.cos(p1) * Math.sin(p2) - Math.sin(p1) * Math.cos(p2) * Math.cos(dl)
        );
        return { dist, brg, name };
      });
      const maxKm = 10000;

      /* ------------------------------------------------------ randomart --- */
      const AW = 17;
      const AH = 9;
      const art = new Uint8Array(AW * AH);
      let bishop = { x: (AW - 1) >> 1, y: (AH - 1) >> 1 };
      let steps = 0;

      if (kind === 'flame') buildFlame();
      if (kind === 'treemap') layout(true);

      return () => {
        f++;
        c.lineWidth = 1;
        c.font = mono(9);
        c.textBaseline = 'middle';

        /* One line of caption, no frame: a box in the corner reads as a
           widget, and this should read as the page having a subject. */
        c.fillStyle = `rgba(${GREY},.22)`;
        c.fillText(CAPTION[kind], bx, by - 12);

        if (kind === 'flame') {
          if (anim && f % 900 === 0) buildFlame();
          const rowH = bh / 6;
          for (const fr of frames) {
            if (anim && fr.grow < 1) fr.grow = Math.min(1, fr.grow + 0.02);
            const w = fr.w * bw * fr.grow;
            if (w < 1) continue;
            const x = bx + fr.x * bw;
            const y = by + bh - (fr.d + 1) * rowH;
            const a = 0.035 + (1 - fr.d / 6) * 0.06;
            c.fillStyle = `rgba(${RED},${a.toFixed(3)})`;
            c.fillRect(x, y + 1, w, rowH - 3);
            c.strokeStyle = `rgba(${RED},${(a * 2).toFixed(3)})`;
            c.strokeRect(x + 0.5, y + 1.5, w - 1, rowH - 4);
          }
        } else if (kind === 'fuzz') {
          if (anim && f % 4 === 0) {
            const i = (Math.random() * cov.length) | 0;
            if (!cov[i]) {
              cov[i] = 1;
              paths++;
              if (Math.random() < 0.03 && crash.length < 6) crash.push(i);
            }
            if (paths >= cov.length * 0.86) {
              cov.fill(0);
              crash.length = 0;
              paths = 0;
            }
          }
          const cw = bw / FC;
          const ch = (bh - 18) / FR;
          for (let i = 0; i < cov.length; i++) {
            const x = bx + (i % FC) * cw;
            const y = by + ((i / FC) | 0) * ch;
            if (!cov[i]) {
              c.strokeStyle = `rgba(${GREY},.05)`;
              c.strokeRect(x + 1.5, y + 1.5, cw - 3, ch - 3);
              continue;
            }
            const bad = crash.includes(i);
            c.fillStyle = bad ? `rgba(${RED},.28)` : `rgba(${RED},.085)`;
            c.fillRect(x + 1, y + 1, cw - 2, ch - 2);
            if (bad) {
              c.strokeStyle = `rgba(${RED},.45)`;
              c.beginPath();
              c.moveTo(x + 3, y + 3);
              c.lineTo(x + cw - 3, y + ch - 3);
              c.moveTo(x + cw - 3, y + 3);
              c.lineTo(x + 3, y + ch - 3);
              c.stroke();
            }
          }
          c.fillStyle = `rgba(${GREY},.26)`;
          c.fillText(`paths ${paths}`, bx, by + bh - 6);
          c.fillStyle = `rgba(${RED},.34)`;
          c.fillText(`crashes ${crash.length}`, bx + 78, by + bh - 6);
        } else if (kind === 'treemap') {
          if (anim && f % 780 === 0) layout(false);
          for (const t of tiles) {
            if (anim) {
              t.x += (t.tx - t.x) * 0.05;
              t.y += (t.ty - t.y) * 0.05;
              t.w += (t.tw - t.w) * 0.05;
              t.h += (t.th - t.h) * 0.05;
            }
            const x = bx + t.x * bw;
            const y = by + t.y * bh;
            const w = t.w * bw;
            const h = t.h * bh;
            c.fillStyle = `rgba(${RED},.035)`;
            c.fillRect(x + 1, y + 1, Math.max(0, w - 2), Math.max(0, h - 2));
            c.strokeStyle = `rgba(${RED},.19)`;
            c.strokeRect(x + 1.5, y + 1.5, Math.max(0, w - 3), Math.max(0, h - 3));
          }
        } else if (kind === 'avalanche') {
          if (anim && mix >= 1 && f % 260 === 0) {
            flipped = (Math.random() * BITS) | 0;
            nextDigest = digest.map(() => (Math.random() < 0.5 ? 0 : 1));
            mix = 0;
          }
          if (anim && mix < 1) {
            mix = Math.min(1, mix + 0.02);
            if (mix >= 1) digest = nextDigest.slice();
          }
          const cw = bw / BITS;
          const rowY = [by + bh * 0.3, by + bh * 0.66];
          c.fillStyle = `rgba(${GREY},.24)`;
          c.fillText('input', bx, rowY[0] - 16);
          c.fillText('digest', bx, rowY[1] - 16);
          for (let i = 0; i < BITS; i++) {
            const x = bx + i * cw;
            const hit = i === flipped;
            c.fillStyle = hit ? `rgba(${RED},.5)` : `rgba(${GREY},.1)`;
            c.fillRect(x + 0.5, rowY[0], Math.max(1, cw - 1.5), 12);

            /* Mid-transition the bit is undecided, which is the whole point. */
            const settled = mix >= 1 || Math.random() > 1 - mix;
            const bit = settled ? nextDigest[i] : Math.random() < 0.5 ? 0 : 1;
            c.fillStyle = bit ? `rgba(${RED},.3)` : `rgba(${GREY},.075)`;
            c.fillRect(x + 0.5, rowY[1], Math.max(1, cw - 1.5), 12);
          }
        } else if (kind === 'azimuth') {
          const cxp = bx + bw / 2;
          const cyp = by + bh / 2;
          const R = Math.min(bw, bh) / 2 - 14;
          for (let ring = 1; ring <= 4; ring++) {
            const r = (R * ring) / 4;
            c.strokeStyle = `rgba(${GREY},${ring === 4 ? 0.14 : 0.07})`;
            c.beginPath();
            c.arc(cxp, cyp, r, 0, 6.2832);
            c.stroke();
            c.fillStyle = `rgba(${GREY},.18)`;
            c.fillText(`${(maxKm * ring) / 4 / 1000}k`, cxp + 4, cyp - r + 7);
          }
          c.strokeStyle = `rgba(${GREY},.07)`;
          for (let i = 0; i < 12; i++) {
            const a = (i / 12) * 6.2832;
            c.beginPath();
            c.moveTo(cxp, cyp);
            c.lineTo(cxp + Math.cos(a) * R, cyp + Math.sin(a) * R);
            c.stroke();
          }
          const sweep = anim ? (f * 0.006) % 6.2832 : 1;
          c.strokeStyle = `rgba(${RED},.18)`;
          c.beginPath();
          c.moveTo(cxp, cyp);
          c.lineTo(cxp + Math.cos(sweep) * R, cyp + Math.sin(sweep) * R);
          c.stroke();

          polar.forEach((p) => {
            const r = (Math.min(p.dist, maxKm) / maxKm) * R;
            const a = p.brg - Math.PI / 2;
            const x = cxp + Math.cos(a) * r;
            const y = cyp + Math.sin(a) * r;
            let da = a - sweep;
            while (da < 0) da += 6.2832;
            const lit = da > 5.9 ? (da - 5.9) / 0.383 : 0;
            c.fillStyle = `rgba(${RED},${(0.28 + lit * 0.45).toFixed(3)})`;
            c.fillRect(x - 2, y - 2, 4, 4);
            if (lit > 0.2) {
              c.fillStyle = `rgba(255,150,160,${(lit * 0.5).toFixed(3)})`;
              c.fillText(p.name, x + 6, y);
            }
          });
          c.fillStyle = `rgba(255,190,196,.5)`;
          c.fillRect(cxp - 2.5, cyp - 2.5, 5, 5);
        } else {
          /* randomart: the drunken bishop walks, two bits a step. */
          if (anim && steps < 104 && f % 3 === 0) {
            /* Two independent bits per step, the way the real one reads two
               bits of the fingerprint — deriving both from one number
               correlates the axes and the walk comes out lopsided. */
            bishop.x = Math.max(0, Math.min(AW - 1, bishop.x + (Math.random() < 0.5 ? -1 : 1)));
            bishop.y = Math.max(0, Math.min(AH - 1, bishop.y + (Math.random() < 0.5 ? -1 : 1)));
            const i = bishop.y * AW + bishop.x;
            if (art[i] < 14) art[i]++;
            steps++;
          } else if (anim && steps >= 104 && f % 620 === 0) {
            art.fill(0);
            bishop = { x: (AW - 1) >> 1, y: (AH - 1) >> 1 };
            steps = 0;
          }
          const cw = bw / AW;
          const ch = (bh - 16) / AH;
          for (let y = 0; y < AH; y++) {
            for (let x = 0; x < AW; x++) {
              const v = art[y * AW + x];
              if (!v) continue;
              const a = Math.min(0.32, 0.04 + v * 0.034);
              c.fillStyle = `rgba(${RED},${a.toFixed(3)})`;
              c.fillRect(bx + x * cw + 1, by + y * ch + 1, cw - 2, ch - 2);
            }
          }
          c.fillStyle = `rgba(255,190,196,.6)`;
          c.fillRect(bx + bishop.x * cw + cw * 0.3, by + bishop.y * ch + ch * 0.3, cw * 0.4, ch * 0.4);
          c.fillStyle = `rgba(${GREY},.22)`;
          c.fillText('ed25519 256', bx, by + bh - 5);
        }
      };
    },
    { additive: false }
  );
</script>
