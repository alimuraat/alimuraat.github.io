---
/**
 * Experience — traceroute.
 *
 * Hops resolve left to right, one at a time, each with a latency reading or a
 * timeout. When a trace reaches the far edge it fades and a new one starts on
 * another row. A path measured hop by hop is the same shape as the page in
 * front of it.
 */
---

<script>
  import { stage } from '../../scripts/stage';

  stage((k) => {
    const { c, W, H, anim, rand, RED, mono } = k;
    const ROWS = Math.max(3, Math.min(7, Math.round(H / 220)));

    type Hop = { x: number; y: number; ms: string; lost: boolean; at: number };
    type Trace = { hops: Hop[]; i: number; u: number; sp: number; fade: number; f: number };

    const makeTrace = (row: number): Trace => {
      const n = 5 + ((Math.random() * 5) | 0);
      const band = H / ROWS;
      const y0 = band * row + band * 0.5 + rand(-band * 0.22, band * 0.22);
      const hops: Hop[] = [];
      for (let i = 0; i <= n; i++) {
        const lost = i > 0 && i < n && Math.random() < 0.16;
        hops.push({
          x: (W / n) * i,
          y: y0 + rand(-26, 26),
          ms: lost ? '* * *' : `${(2 + Math.random() * 96) | 0} ms`,
          lost,
          at: -1,
        });
      }
      return { hops, i: 0, u: 0, sp: rand(0.006, 0.016), fade: 0, f: 0 };
    };

    const traces = Array.from({ length: ROWS }, (_, r) => {
      const t = makeTrace(r);
      /* Stagger the start so they do not march in lockstep. */
      t.i = (Math.random() * t.hops.length) | 0;
      for (let h = 0; h <= t.i; h++) t.hops[h].at = 0;
      return t;
    });

    return () => {
      c.lineWidth = 1;
      c.font = mono(9);
      c.textBaseline = 'middle';

      for (let r = 0; r < traces.length; r++) {
        const t = traces[r];
        t.f++;

        if (anim) {
          if (t.i < t.hops.length - 1) {
            t.u += t.sp;
            if (t.u >= 1) {
              t.u = 0;
              t.i++;
              t.hops[t.i].at = t.f;
            }
          } else {
            t.fade += 0.006;
            if (t.fade >= 1) traces[r] = makeTrace(r);
          }
        }

        const alive = 1 - t.fade;

        /* Resolved section of the path. */
        c.strokeStyle = `rgba(${RED},${(0.19 * alive).toFixed(3)})`;
        c.beginPath();
        c.moveTo(t.hops[0].x, t.hops[0].y);
        for (let h = 1; h <= t.i; h++) c.lineTo(t.hops[h].x, t.hops[h].y);
        c.stroke();

        /* The leg currently being measured, plus its head. */
        if (t.i < t.hops.length - 1) {
          const a = t.hops[t.i];
          const b = t.hops[t.i + 1];
          const hx = a.x + (b.x - a.x) * t.u;
          const hy = a.y + (b.y - a.y) * t.u;
          c.strokeStyle = `rgba(${RED},${(0.28 * alive).toFixed(3)})`;
          c.beginPath();
          c.moveTo(a.x, a.y);
          c.lineTo(hx, hy);
          c.stroke();

          const g = c.createRadialGradient(hx, hy, 0, hx, hy, 14);
          g.addColorStop(0, `rgba(255,90,105,${0.5 * alive})`);
          g.addColorStop(1, `rgba(${RED},0)`);
          c.fillStyle = g;
          c.beginPath();
          c.arc(hx, hy, 14, 0, 6.2832);
          c.fill();
          c.fillStyle = `rgba(255,200,205,${0.85 * alive})`;
          c.fillRect(hx - 1.6, hy - 1.6, 3.2, 3.2);
        }

        for (let h = 0; h <= t.i; h++) {
          const hop = t.hops[h];
          const age = (t.f - hop.at) / 190;
          const fresh = age < 1 ? 1 - age : 0;

          c.strokeStyle = `rgba(${RED},${((hop.lost ? 0.18 : 0.38) * alive + fresh * 0.3).toFixed(3)})`;
          c.strokeRect(hop.x - 2.5, hop.y - 2.5, 5, 5);

          if (fresh > 0) {
            c.fillStyle = hop.lost
              ? `rgba(140,140,150,${(fresh * 0.45 * alive).toFixed(3)})`
              : `rgba(255,140,150,${(fresh * 0.5 * alive).toFixed(3)})`;
            c.fillText(hop.ms, hop.x + 7, hop.y - 9);
          }
        }
      }
    };
  });
</script>
